{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmaflow.local/schemas/invoice-ai-training-record.schema.json",
  "title": "PharmaFlow Invoice AI Training Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "datasetVersion",
    "image",
    "split",
    "source",
    "quality",
    "items"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,80}$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "mimeType"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test", "quarantine"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "captureType"],
      "properties": {
        "layoutId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "captureType": {
          "type": "string",
          "enum": ["camera", "scan", "pdf", "upload"]
        },
        "supplierLabel": {
          "type": ["string", "null"],
          "maxLength": 120
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanVerified",
        "allStockRowsChecked",
        "passedQualityGate"
      ],
      "properties": {
        "humanVerified": {
          "type": "boolean"
        },
        "allStockRowsChecked": {
          "type": "boolean"
        },
        "passedQualityGate": {
          "type": "boolean"
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rowId",
          "productName",
          "batchNumber",
          "expiryDate",
          "quantity"
        ],
        "properties": {
          "rowId": {
            "type": "integer",
            "minimum": 1
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "batchNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expiryDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "quantity": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "fieldReview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "productName": {
                "type": "string",
                "enum": ["verified", "corrected", "unreadable"]
              },
              "batchNumber": {
                "type": "string",
                "enum": ["verified", "corrected", "unreadable"]
              },
              "expiryDate": {
                "type": "string",
                "enum": ["verified", "corrected", "unreadable"]
              },
              "quantity": {
                "type": "string",
                "enum": ["verified", "corrected", "unreadable"]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "split": {
            "const": "train"
          }
        }
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "passedQualityGate": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "split": {
            "const": "validation"
          }
        }
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "passedQualityGate": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "split": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "passedQualityGate": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
