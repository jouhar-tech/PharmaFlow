@model PharmaFlow.Models.ViewModels.CreateBillViewModel

@{
    ViewData["Title"] = "Create Bill";
    var billingError = TempData["BillingError"] as string;
}

<div class="billing-create-page">
    <header class="billing-create-mobile-header">
        <a asp-controller="Home" asp-action="Index" class="billing-create-back" aria-label="Back to dashboard">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m11 18-6-6 6-6"></path>
            </svg>
        </a>

        <h1>Create Invoice</h1>
        <span class="billing-create-header-spacer" aria-hidden="true"></span>
    </header>

    <form asp-controller="Billing"
          asp-action="Generate"
          method="post"
          class="billing-create-content"
          id="billingCreateForm"
          novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PaymentMethod" id="billingPaymentMethod" value="Cash" />
        <input type="hidden" asp-for="ItemsJson" id="billingItemsJson" />

        @if (!string.IsNullOrWhiteSpace(billingError))
        {
            <div class="billing-create-alert" role="alert">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5M12 16h.01"></path>
                </svg>
                <span>@billingError</span>
            </div>
        }

        <section class="billing-product-search" aria-label="Add medicine">
            <label class="billing-search-wrap" for="billingProductSearch">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="m16 16 4.5 4.5"></path>
                </svg>
                <input id="billingProductSearch"
                       type="search"
                       autocomplete="off"
                       maxlength="80"
                       placeholder="Search medicine or drug"
                       aria-label="Search medicine or drug" />
            </label>

            <div class="billing-search-results" id="billingSearchResults" hidden></div>
        </section>

        <section class="billing-customer-card" aria-labelledby="billingCustomerTitle">
            <div class="billing-section-heading">
                <div class="billing-section-icon billing-section-icon-customer" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="3.2"></circle>
                        <path d="M5.5 20c.8-3.3 3-5 6.5-5s5.7 1.7 6.5 5"></path>
                    </svg>
                </div>
                <h2 id="billingCustomerTitle">Customer Details</h2>
            </div>

            <div class="billing-field-group">
                <label for="billingCustomerName">Customer Name</label>
                <div class="billing-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="3.2"></circle>
                        <path d="M5.5 20c.8-3.3 3-5 6.5-5s5.7 1.7 6.5 5"></path>
                    </svg>
                    <input id="billingCustomerName"
                           name="CustomerName"
                           type="text"
                           maxlength="120"
                           autocomplete="name"
                           placeholder="Customer Name (Optional)" />
                </div>
            </div>

            <div class="billing-field-group">
                <label for="billingPhoneNumber">Phone Number</label>
                <div class="billing-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7.1 4.8 5.7 6.2c-.8.8-.8 2.1-.1 3.1 2.1 3.1 5.1 6.1 8.2 8.2 1 .7 2.3.7 3.1-.1l1.4-1.4c.5-.5.5-1.3.1-1.9l-1.8-2.5c-.4-.6-1.2-.8-1.8-.5l-1.7.8c-1.7-1-3.1-2.5-4.1-4.1l.8-1.7c.3-.7.1-1.4-.5-1.8L9 4.7c-.6-.4-1.4-.4-1.9.1Z"></path>
                    </svg>
                    <input id="billingPhoneNumber"
                           name="PhoneNumber"
                           type="tel"
                           inputmode="numeric"
                           maxlength="15"
                           autocomplete="tel"
                           placeholder="Phone Number (Optional)" />
                </div>
                <small class="billing-field-hint">For Udhaar, provide a customer name or valid 10-digit phone number.</small>
            </div>
        </section>

        <section class="billing-items-section" aria-labelledby="billingItemsTitle">
            <div class="billing-section-heading billing-section-heading-plain">
                <h2 id="billingItemsTitle">Itemized Summary</h2>
            </div>

            <div class="billing-items-card" id="billingItemsCard">
                <div class="billing-empty-items" id="billingEmptyItems">
                    <div class="billing-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="5" y="3.5" width="14" height="17" rx="2"></rect>
                            <path d="M8.5 8h7M8.5 12h7M8.5 16h4.5"></path>
                        </svg>
                    </div>
                    <div>
                        <strong>No medicines added yet</strong>
                        <span>Search for a medicine above and select an available batch.</span>
                    </div>
                </div>

                <div class="billing-item-list" id="billingItemList" hidden></div>

                <div class="billing-total-strip" id="billingTotalStrip" hidden>
                    <span>Total Amount</span>
                    <strong id="billingLiveTotal">₹0.00</strong>
                </div>
            </div>
        </section>

        <section class="billing-payment-section" aria-labelledby="billingPaymentTitle">
            <div class="billing-section-heading billing-section-heading-plain">
                <h2 id="billingPaymentTitle">Payment Method</h2>
            </div>

            <div class="billing-payment-options" role="group" aria-label="Payment method">
                <button type="button" class="billing-payment-option is-selected" data-payment-method="Cash" aria-pressed="true">
                    <span class="billing-payment-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="6" width="18" height="12" rx="2"></rect>
                            <circle cx="12" cy="12" r="2.2"></circle>
                            <path d="M6 9h.01M18 15h.01"></path>
                        </svg>
                    </span>
                    <span>Cash</span>
                </button>

                <button type="button" class="billing-payment-option" data-payment-method="UPI" aria-pressed="false">
                    <span class="billing-payment-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 12h10"></path>
                            <path d="m11 7 6 5-6 5"></path>
                            <path d="M19 7v10"></path>
                        </svg>
                    </span>
                    <span>UPI</span>
                </button>

                <button type="button" class="billing-payment-option" data-payment-method="Udhaar" aria-pressed="false">
                    <span class="billing-payment-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="5" y="4" width="14" height="16" rx="2"></rect>
                            <path d="M8 8h8M8 12h5"></path>
                            <circle cx="16.5" cy="16.5" r="2.5"></circle>
                            <path d="m15.4 16.5.8.8 1.5-1.6"></path>
                        </svg>
                    </span>
                    <span>Udhaar</span>
                </button>
            </div>
        </section>

        <button type="submit" class="billing-generate-button" id="billingGenerateButton">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 3.5h9l3 3V20.5H6z"></path>
                <path d="M14 3.5v4h4M9 11h6M9 15h6"></path>
                <circle cx="17.2" cy="17.2" r="3.2"></circle>
                <path d="m15.9 17.2.9.9 1.8-1.9"></path>
            </svg>
            <span>Generate Bill</span>
        </button>
    </form>

    <div class="billing-catalog-modal" id="billingCatalogStockModal" hidden>
        <div class="billing-catalog-modal-backdrop" data-catalog-modal-close></div>
        <section class="billing-catalog-modal-panel"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="billingCatalogStockTitle">
            <header class="billing-catalog-modal-header">
                <div>
                    <span class="billing-catalog-modal-eyebrow">GLOBAL MEDICINE CATALOG</span>
                    <h2 id="billingCatalogStockTitle">Add physical stock to bill</h2>
                    <p id="billingCatalogStockProductMeta"></p>
                </div>
                <button type="button"
                        class="billing-catalog-modal-close"
                        id="billingCatalogStockClose"
                        aria-label="Close">×</button>
            </header>

            <div class="billing-catalog-modal-body">
            <div class="billing-catalog-modal-note">
                Enter the details from the actual product pack. The physical quantity entered
                will be added to this pharmacy's inventory, and the billed quantity will be
                deducted when the bill is generated.
            </div>

            <div class="billing-catalog-modal-warning" id="billingCatalogPrescriptionWarning" hidden>
                This catalogue record is marked as prescription-required. Verify the prescription
                and applicable dispensing rules before sale.
                <label class="billing-catalog-prescription-confirm">
                    <input id="billingCatalogPrescriptionConfirm" type="checkbox" />
                    <span>I have verified the required prescription.</span>
                </label>
            </div>

            <div class="billing-catalog-stock-grid">
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogBatchNumber">Batch / Lot number *</label>
                    <input id="billingCatalogBatchNumber" type="text" maxlength="100"
                           autocomplete="off" required />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogExpiryDate">Expiry date *</label>
                    <input id="billingCatalogExpiryDate" type="date" required />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogAvailableQuantity">Physical quantity on shelf *</label>
                    <input id="billingCatalogAvailableQuantity" type="number" min="0.01"
                           max="999999" step="0.01" inputmode="decimal" required />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogQuantityToBill">Quantity to bill *</label>
                    <input id="billingCatalogQuantityToBill" type="number" min="0.01"
                           step="0.01" value="1" inputmode="decimal" required />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogPurchasePrice">Purchase price / unit</label>
                    <input id="billingCatalogPurchasePrice" type="number" min="0"
                           max="999999999" step="0.01" inputmode="decimal"
                           placeholder="Optional" />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogSellingPrice">Selling price / unit *</label>
                    <input id="billingCatalogSellingPrice" type="number" min="0.01"
                           max="999999999" step="0.01" inputmode="decimal" required />
                </div>
                <div class="billing-catalog-stock-field">
                    <label for="billingCatalogGstRate">GST rate (%) *</label>
                    <input id="billingCatalogGstRate" type="number" min="0" max="100"
                           step="0.01" inputmode="decimal" required />
                </div>
            </div>

            <div class="billing-catalog-modal-footnote">
                Catalogue data is reference information, not an authoritative medicine or tax record.
                Verify the exact brand, strength, pack size, batch, expiry, printed MRP, GST and
                prescription requirements from the physical product and applicable rules. The Indian
                dataset may not provide reliable HSN, GST or prescription-schedule details. Enter the
                total usable stock on the shelf, not only the quantity being sold.
            </div>

            <div class="billing-catalog-modal-error" id="billingCatalogStockError"
                 role="alert" hidden></div>

            </div>

            <footer class="billing-catalog-modal-actions">
                <button type="button" class="billing-catalog-cancel" id="billingCatalogStockCancel">
                    Cancel
                </button>
                <button type="button" class="billing-catalog-save" id="billingCatalogStockSave">
                    Add stock & add to bill
                </button>
            </footer>
        </section>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const searchInput = document.getElementById("billingProductSearch");
        const searchResults = document.getElementById("billingSearchResults");
        const itemList = document.getElementById("billingItemList");
        const emptyItems = document.getElementById("billingEmptyItems");
        const totalStrip = document.getElementById("billingTotalStrip");
        const liveTotal = document.getElementById("billingLiveTotal");
        const itemsJson = document.getElementById("billingItemsJson");
        const paymentInput = document.getElementById("billingPaymentMethod");
        const createForm = document.getElementById("billingCreateForm");
        const generateButton = document.getElementById("billingGenerateButton");
        const catalogStockModal = document.getElementById("billingCatalogStockModal");
        const catalogStockTitle = document.getElementById("billingCatalogStockTitle");
        const catalogStockProductMeta = document.getElementById("billingCatalogStockProductMeta");
        const catalogPrescriptionWarning = document.getElementById("billingCatalogPrescriptionWarning");
        const catalogPrescriptionConfirm = document.getElementById("billingCatalogPrescriptionConfirm");
        const catalogBatchNumber = document.getElementById("billingCatalogBatchNumber");
        const catalogExpiryDate = document.getElementById("billingCatalogExpiryDate");
        const catalogAvailableQuantity = document.getElementById("billingCatalogAvailableQuantity");
        const catalogQuantityToBill = document.getElementById("billingCatalogQuantityToBill");
        const catalogPurchasePrice = document.getElementById("billingCatalogPurchasePrice");
        const catalogSellingPrice = document.getElementById("billingCatalogSellingPrice");
        const catalogGstRate = document.getElementById("billingCatalogGstRate");
        const catalogStockSave = document.getElementById("billingCatalogStockSave");
        const catalogStockError = document.getElementById("billingCatalogStockError");

        const state = {
            items: new Map(),
            searchTimer: null,
            requestSequence: 0,
            activeController: null,
            catalogResults: []
        };

        let selectedCatalogProduct = null;

        const formatMoney = value =>
            "₹" + Number(value || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

        const escapeHtml = value =>
            String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        const syncForm = () => {
            const payload = Array.from(state.items.values()).map(item => ({
                batchId: item.batchId,
                quantity: item.quantity
            }));

            itemsJson.value = JSON.stringify(payload);

            const total = Array.from(state.items.values())
                .reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);

            liveTotal.textContent = formatMoney(total);

            const hasItems = state.items.size > 0;
            emptyItems.hidden = hasItems;
            itemList.hidden = !hasItems;
            totalStrip.hidden = !hasItems;
            generateButton.classList.toggle("is-ready", hasItems);
        };

        const renderItems = () => {
            itemList.innerHTML = "";

            for (const item of state.items.values()) {
                const card = document.createElement("article");
                card.className = "billing-line-card";
                card.dataset.batchId = String(item.batchId);

                card.innerHTML = `
                    <div class="billing-line-main">
                        <div class="billing-line-product-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 8.5 12 4l7 4.5-7 4.5z"></path>
                                <path d="M5 8.5V16l7 4 7-4V8.5M12 13v7"></path>
                            </svg>
                        </div>
                        <div class="billing-line-copy">
                            <strong>${escapeHtml(item.productName)}</strong>
                            <span>Batch ${escapeHtml(item.batchNumber)} · Exp ${escapeHtml(item.expiryDate)}</span>
                            <small>Rate ${formatMoney(item.unitPrice)} · GST ${Number(item.gstRate || 0).toFixed(2)}%</small>
                        </div>
                        <button type="button" class="billing-line-remove" data-action="remove" aria-label="Remove item">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 7h14M9 7V4.5h6V7M8 7l.7 13h6.6L16 7M10 11v5M14 11v5"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="billing-line-bottom">
                        <div class="billing-stock-note">Available ${Number(item.availableQty).toLocaleString("en-IN", { maximumFractionDigits: 2 })}</div>
                        <div class="billing-qty-control" aria-label="Quantity">
                            <button type="button" data-action="minus" aria-label="Decrease quantity">−</button>
                            <strong>${Number(item.quantity).toLocaleString("en-IN", { maximumFractionDigits: 2 })}</strong>
                            <button type="button" data-action="plus" aria-label="Increase quantity">+</button>
                        </div>
                        <strong class="billing-line-total">${formatMoney(item.unitPrice * item.quantity)}</strong>
                    </div>
                `;

                itemList.appendChild(card);
            }

            syncForm();
        };

        const addBatch = (batch, initialQuantity = 1) => {
            const requestedQuantity = Number(initialQuantity || 1);
            const existing = state.items.get(batch.batchId);

            if (existing) {
                existing.quantity = Math.min(
                    existing.availableQty,
                    existing.quantity + requestedQuantity
                );
            } else {
                state.items.set(batch.batchId, {
                    ...batch,
                    quantity: Math.min(Number(batch.availableQty || 0), requestedQuantity)
                });
            }

            searchResults.hidden = true;
            searchInput.value = "";
            renderItems();
            searchInput.focus();
        };

        const sourceLabel = source => {
            switch (source) {
                case "india-medicine-api": return "Indian medicine dataset";
                case "openfda-ndc": return "US FDA reference";
                case "openfoodfacts": return "Open Food Facts";
                default: return "External catalogue";
            }
        };

        const renderSearchResults = (products, query) => {
            const rows = [];

            for (const product of products) {
                for (const batch of (product.batches || [])) {
                    const disabled = Number(batch.sellingUnitPrice || 0) <= 0 ||
                        Number(batch.quantityOnHand || 0) <= 0;

                    rows.push(`
                        <button type="button"
                                class="billing-search-result"
                                data-batch-id="${batch.batchId}"
                                ${disabled ? "disabled" : ""}>
                            <span class="billing-search-result-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M5 8.5 12 4l7 4.5-7 4.5z"></path>
                                    <path d="M5 8.5V16l7 4 7-4V8.5"></path>
                                </svg>
                            </span>
                            <span class="billing-search-result-copy">
                                <strong>${escapeHtml(product.productName)}</strong>
                                <small>Batch ${escapeHtml(batch.batchNumber)} · Exp ${escapeHtml(batch.expiryDate)} · Stock ${Number(batch.quantityOnHand).toLocaleString("en-IN", { maximumFractionDigits: 2 })}</small>
                            </span>
                            <span class="billing-search-result-price">
                                ${disabled ? "Price not set" : formatMoney(batch.sellingUnitPrice)}
                            </span>
                        </button>
                    `);
                }
            }

            const emptyMarkup = rows.length === 0
                ? `<div class="billing-search-empty">
                       <strong>No saleable stock found in your inventory</strong>
                       <span>You can search the global catalogue and record the physical batch you have on the shelf.</span>
                   </div>`
                : "";

            searchResults.innerHTML = emptyMarkup + rows.join("") + `
                <button type="button"
                        class="billing-global-search-trigger"
                        data-action="search-global-catalog">
                    Search global medicine catalogue for “${escapeHtml(query)}”
                </button>`;

            searchResults.hidden = false;

            searchResults.querySelectorAll(".billing-search-result:not(:disabled)").forEach(button => {
                button.addEventListener("click", () => {
                    const batchId = Number(button.dataset.batchId);
                    const batch = products
                        .flatMap(product => product.batches || [])
                        .find(item => Number(item.batchId) === batchId);

                    const product = products.find(p =>
                        (p.batches || []).some(item => Number(item.batchId) === batchId));

                    if (!batch || !product) return;

                    addBatch({
                        batchId: Number(batch.batchId),
                        productName: product.productName,
                        batchNumber: batch.batchNumber,
                        expiryDate: batch.expiryDate,
                        availableQty: Number(batch.quantityOnHand || 0),
                        unitPrice: Number(batch.sellingUnitPrice || 0),
                        mrp: Number(batch.mrp || batch.sellingUnitPrice || 0),
                        gstRate: Number(product.gstRate || 0)
                    });
                });
            });

            searchResults.querySelector("[data-action='search-global-catalog']")
                ?.addEventListener("click", () => searchGlobalCatalog(query));
        };

        const renderCatalogResults = products => {
            state.catalogResults = products || [];

            if (!state.catalogResults.length) {
                searchResults.innerHTML = `
                    <div class="billing-search-empty">
                        <strong>No global catalogue matches</strong>
                        <span>Try the generic name, brand name or barcode. You can add a custom product from Inventory if it is not listed.</span>
                    </div>`;
                searchResults.hidden = false;
                return;
            }

            const rows = state.catalogResults.map((product, index) => {
                const detailParts = [
                    product.genericName,
                    product.strength,
                    product.packSize,
                    product.manufacturer
                ].filter(Boolean);

                const subtitle = detailParts.length
                    ? detailParts.join(" · ")
                    : sourceLabel(product.source);

                return `
                    <button type="button"
                            class="billing-catalog-result"
                            data-catalog-index="${index}">
                        <span class="billing-search-result-icon" aria-hidden="true">＋</span>
                        <span class="billing-search-result-copy">
                            <strong>${escapeHtml(product.productName)}</strong>
                            <small>${escapeHtml(subtitle)} · ${escapeHtml(sourceLabel(product.source))}</small>
                        </span>
                        <span class="billing-search-result-price">Add stock</span>
                    </button>`;
            });

            searchResults.innerHTML = `
                <div class="billing-global-catalog-heading">
                    Global catalogue results <span>${state.catalogResults.length}</span>
                </div>
                ${rows.join("")}
                <div class="billing-global-catalog-footnote">
                    Catalogue details are reference data. Verify the physical pack before adding stock.
                </div>`;

            searchResults.hidden = false;

            searchResults.querySelectorAll(".billing-catalog-result").forEach(button => {
                button.addEventListener("click", () => {
                    const product = state.catalogResults[Number(button.dataset.catalogIndex)];
                    if (product) openCatalogStockModal(product);
                });
            });
        };

        const loadCatalogResults = async (query, sequence) => {
            if (sequence !== state.requestSequence) return;

            searchResults.hidden = false;
            searchResults.innerHTML = `
                <div class="billing-search-loading">
                    <span class="billing-mini-spinner" aria-hidden="true"></span>
                    <span>Searching global medicine catalogue...</span>
                </div>`;

            try {
                const response = await fetch(
                    '@Url.Action("SearchCatalog", "Billing")?q=' + encodeURIComponent(query.trim()),
                    {
                        credentials: "same-origin",
                        signal: state.activeController?.signal
                    });

                if (sequence !== state.requestSequence) return;
                const products = response.ok ? await response.json() : [];

                if (!response.ok) {
                    throw new Error("Global catalogue search failed.");
                }

                renderCatalogResults(products);
            } catch (error) {
                if (error?.name === "AbortError") return;
                if (sequence !== state.requestSequence) return;

                searchResults.innerHTML = `
                    <div class="billing-search-empty">
                        <strong>Global catalogue is temporarily unavailable</strong>
                        <span>Your existing inventory search is still available. Please retry in a moment.</span>
                    </div>`;
                searchResults.hidden = false;
            }
        };

        const searchGlobalCatalog = async query => {
            const sequence = ++state.requestSequence;
            state.activeController?.abort();
            state.activeController = new AbortController();
            await loadCatalogResults(query, sequence);
        };

        const loadSearchResults = async query => {
            const sequence = ++state.requestSequence;
            state.activeController?.abort();
            state.activeController = new AbortController();

            if (!query.trim()) {
                searchResults.hidden = true;
                searchResults.innerHTML = "";
                return;
            }

            searchResults.hidden = false;
            searchResults.innerHTML = `
                <div class="billing-search-loading">
                    <span class="billing-mini-spinner" aria-hidden="true"></span>
                    <span>Searching your inventory...</span>
                </div>`;

            try {
                const response = await fetch(
                    '@Url.Action("Search", "Billing")?q=' + encodeURIComponent(query.trim()),
                    {
                        credentials: "same-origin",
                        signal: state.activeController.signal
                    });

                if (sequence !== state.requestSequence) return;

                if (!response.ok) {
                    throw new Error("Inventory search failed.");
                }

                const products = await response.json();
                if (products.length === 0) {
                    await loadCatalogResults(query, sequence);
                } else {
                    renderSearchResults(products, query);
                }
            } catch (error) {
                if (error?.name === "AbortError") return;
                if (sequence !== state.requestSequence) return;

                searchResults.innerHTML = `
                    <div class="billing-search-empty">
                        <strong>Could not search inventory</strong>
                        <span>Check your connection and try again.</span>
                    </div>`;
                searchResults.hidden = false;
            }
        };

        const closeCatalogStockModal = () => {
            if (catalogStockModal) catalogStockModal.hidden = true;
            document.body.classList.remove("billing-catalog-modal-open");
            if (catalogStockError) {
                catalogStockError.hidden = true;
                catalogStockError.textContent = "";
            }
            selectedCatalogProduct = null;
        };

        const openCatalogStockModal = product => {
            selectedCatalogProduct = product;
            catalogStockTitle.textContent = product.productName || "Add catalogue product";
            const details = [
                product.genericName,
                product.strength,
                product.packSize,
                product.manufacturer
            ].filter(Boolean);
            catalogStockProductMeta.textContent = details.join(" · ") || sourceLabel(product.source);

            catalogPrescriptionWarning.hidden = !product.isPrescriptionRequired;
            if (catalogPrescriptionConfirm) catalogPrescriptionConfirm.checked = false;

            catalogBatchNumber.value = "";
            catalogExpiryDate.value = "";
            catalogAvailableQuantity.value = "";
            catalogQuantityToBill.value = "1";
            catalogPurchasePrice.value = "";
            catalogSellingPrice.value = "";
            catalogGstRate.value = product.gstRate == null
                ? ""
                : String(Number(product.gstRate));

            const now = new Date();
            const localDate = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
                .toISOString()
                .slice(0, 10);
            catalogExpiryDate.min = localDate;

            catalogStockError.hidden = true;
            catalogStockError.textContent = "";
            catalogStockSave.disabled = false;
            catalogStockSave.textContent = "Add stock & add to bill";
            catalogStockModal.hidden = false;
            document.body.classList.add("billing-catalog-modal-open");
            catalogBatchNumber.focus();
        };

        const saveCatalogStock = async () => {
            if (!selectedCatalogProduct || catalogStockSave.disabled) return;

            const requiredInputs = [
                catalogBatchNumber,
                catalogExpiryDate,
                catalogAvailableQuantity,
                catalogQuantityToBill,
                catalogSellingPrice,
                catalogGstRate
            ];

            const firstInvalid = requiredInputs.find(input => !input.checkValidity());
            if (firstInvalid) {
                firstInvalid.reportValidity();
                return;
            }

            const availableQuantity = Number(catalogAvailableQuantity.value);
            const quantityToBill = Number(catalogQuantityToBill.value);

            if (quantityToBill > availableQuantity) {
                catalogStockError.textContent =
                    "Quantity to bill cannot exceed the physical quantity available on the shelf.";
                catalogStockError.hidden = false;
                catalogQuantityToBill.focus();
                return;
            }

            if (selectedCatalogProduct.isPrescriptionRequired &&
                !catalogPrescriptionConfirm?.checked) {
                catalogStockError.textContent =
                    "Confirm that the required prescription has been verified before adding this product.";
                catalogStockError.hidden = false;
                catalogPrescriptionConfirm?.focus();
                return;
            }

            const token = createForm.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                catalogStockError.textContent =
                    "Security token is missing. Refresh the billing page and try again.";
                catalogStockError.hidden = false;
                return;
            }

            const payload = {
                catalogId: selectedCatalogProduct.catalogId,
                source: selectedCatalogProduct.source,
                externalId: selectedCatalogProduct.externalId,
                batchNumber: catalogBatchNumber.value.trim(),
                expiryDate: catalogExpiryDate.value,
                availableQuantity,
                quantityToBill,
                purchaseUnitPrice: catalogPurchasePrice.value === ""
                    ? null
                    : Number(catalogPurchasePrice.value),
                sellingUnitPrice: Number(catalogSellingPrice.value),
                gstRate: catalogGstRate.value === ""
                    ? null
                    : Number(catalogGstRate.value),
                prescriptionConfirmed: !!catalogPrescriptionConfirm?.checked
            };

            catalogStockSave.disabled = true;
            catalogStockSave.textContent = "Adding stock...";
            catalogStockError.hidden = true;

            try {
                const response = await fetch('@Url.Action("AddCatalogStock", "Billing")', {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify(payload)
                });

                let result = null;
                try {
                    result = await response.json();
                } catch {
                    // Show the safe generic error below.
                }

                if (!response.ok || !result?.success || !result?.batch) {
                    throw new Error(
                        result?.message ||
                        "The product stock could not be added. Please check the details and retry."
                    );
                }

                const batch = result.batch;
                addBatch({
                    batchId: Number(batch.batchId),
                    productName: batch.productName,
                    batchNumber: batch.batchNumber,
                    expiryDate: batch.expiryDate,
                    availableQty: Number(batch.availableQty || 0),
                    unitPrice: Number(batch.unitPrice || 0),
                    mrp: Number(batch.mrp || batch.unitPrice || 0),
                    gstRate: Number(batch.gstRate || 0)
                }, Number(result.quantityToBill || 1));

                closeCatalogStockModal();
            } catch (error) {
                catalogStockError.textContent =
                    error?.message || "The product stock could not be added. Please retry.";
                catalogStockError.hidden = false;
            } finally {
                catalogStockSave.disabled = false;
                catalogStockSave.textContent = "Add stock & add to bill";
            }
        };

        document.getElementById("billingCatalogStockClose")
            ?.addEventListener("click", closeCatalogStockModal);
        document.getElementById("billingCatalogStockCancel")
            ?.addEventListener("click", closeCatalogStockModal);
        catalogStockModal?.querySelectorAll("[data-catalog-modal-close]")
            .forEach(element => element.addEventListener("click", closeCatalogStockModal));
        catalogStockSave?.addEventListener("click", saveCatalogStock);

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && catalogStockModal && !catalogStockModal.hidden) {
                closeCatalogStockModal();
            }
        });

        searchInput?.addEventListener("input", () => {
            clearTimeout(state.searchTimer);
            const query = searchInput.value;

            state.searchTimer = setTimeout(() => loadSearchResults(query), 500);
        });

        document.addEventListener("click", event => {
            if (!event.target.closest(".billing-product-search")) {
                searchResults.hidden = true;
            }
        });

        itemList?.addEventListener("click", event => {
            const button = event.target.closest("button[data-action]");
            if (!button) return;

            const card = button.closest(".billing-line-card");
            const batchId = Number(card?.dataset.batchId);
            const item = state.items.get(batchId);

            if (!item) return;

            const action = button.dataset.action;

            if (action === "remove") {
                state.items.delete(batchId);
            } else if (action === "minus") {
                item.quantity = Math.max(1, item.quantity - 1);
            } else if (action === "plus") {
                item.quantity = Math.min(item.availableQty, item.quantity + 1);
            }

            renderItems();
        });

        document.querySelectorAll(".billing-payment-option").forEach(button => {
            button.addEventListener("click", () => {
                const selectedMethod = button.dataset.paymentMethod || "Cash";

                document.querySelectorAll(".billing-payment-option").forEach(item => {
                    const active = item === button;
                    item.classList.toggle("is-selected", active);
                    item.setAttribute("aria-pressed", String(active));
                });

                paymentInput.value = selectedMethod;
            });
        });

        createForm?.addEventListener("submit", event => {
            if (state.items.size === 0) {
                event.preventDefault();
                generateButton.classList.add("billing-submit-error");
                setTimeout(() => generateButton.classList.remove("billing-submit-error"), 450);
                return;
            }

            const selected = document.querySelector(".billing-payment-option.is-selected");
            if (selected) {
                paymentInput.value = selected.dataset.paymentMethod || "Cash";
            }

            syncForm();
            generateButton.disabled = true;
            generateButton.setAttribute("aria-busy", "true");
            generateButton.querySelector("span").textContent = "Generating...";
        });

        syncForm();
    })();
</script>
}
