@model PharmaFlow.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="more-mobile-page">
    @if (TempData["StaffMessage"] is string staffMessage)
    {
        <div class="more-mobile-staff-success">@staffMessage</div>
    }


    <header class="more-mobile-header">
        <a asp-controller="Home" asp-action="Index" class="more-mobile-back" aria-label="Back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg></a>
        <h1 data-i18n="more">More</h1>
    </header>

    <section class="more-mobile-profile-card">
        <div class="more-mobile-business">
            <h2>@Model.BusinessName</h2>
            <span>PharmaFlow</span>
        </div>
        <div class="more-mobile-avatar">
            @((Model.Username.Length > 0 ? Model.Username[0] : 'U').ToString().ToUpperInvariant())
        </div>
    </section>

    <section class="more-mobile-menu-card">
        @if (!string.Equals(Context.Session.GetString("UserRole"), "Staff", StringComparison.OrdinalIgnoreCase))
        {
            <div class="more-mobile-section-title" data-i18n="business">Business</div>
            <a asp-controller="Profile" asp-action="BusinessSummary" class="more-mobile-row">
                <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h6M7 17h4"/></svg></span>
                <span class="more-mobile-row-label" data-i18n="businessSummary">Business Summary</span>
                <span class="more-mobile-chevron">›</span>
            </a>
            <a asp-controller="Reports" asp-action="Index" class="more-mobile-row">
                <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
                <span class="more-mobile-row-label" data-i18n="reports">Reports</span>
                <span class="more-mobile-chevron">›</span>
            </a>
        }
    </section>

    <section class="more-mobile-menu-card">
        <div class="more-mobile-section-title" data-i18n="inventory">Inventory</div>
        <a asp-controller="Purchase" asp-action="Index" class="more-mobile-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-2.5-1.6L13 21l-3-1.6L7.5 21 6 20V3Z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="purchase">Purchase</span>
            <span class="more-mobile-chevron">›</span>
        </a>
        <a asp-controller="Bills" asp-action="Index" class="more-mobile-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5z"/><path d="M8 8h8M8 12h8M8 16h4"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="bills">Bills</span>
            <span class="more-mobile-chevron">›</span>
        </a>
    </section>

    <section class="more-mobile-menu-card">
        <div class="more-mobile-section-title" data-i18n="people">People</div>
        <a asp-controller="Customers" asp-action="Index" class="more-mobile-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1.2a4.5 4.5 0 0 0-4.5-4.5H7.5A4.5 4.5 0 0 0 3 18.8V20"/><circle cx="9.5" cy="7.5" r="3.2"/><path d="M16 4.8a3.2 3.2 0 0 1 0 5.4M21 20v-1.2a4.5 4.5 0 0 0-3.1-4.3"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="customers">Customers</span>
            <span class="more-mobile-chevron">›</span>
        </a>
        @if (!string.Equals(Context.Session.GetString("UserRole"), "Staff", StringComparison.OrdinalIgnoreCase))
        {
            <a asp-controller="Staff" asp-action="Add" class="more-mobile-row">
                <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M19 8v6M16 11h6"/></svg></span>
                <span class="more-mobile-row-label" data-i18n="staff">Staff</span>
                <span class="more-mobile-chevron">›</span>
            </a>
        }
    </section>

    <section class="more-mobile-settings-card">
        <div class="more-mobile-section-title" data-i18n="settings">Settings</div>

        <div class="more-mobile-row more-mobile-language-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h9M8.5 3v2M6 8c1.2 3.2 3.4 5.5 7 7M11 8c-1.2 2.8-3.2 5-6 6M14 17l3-7 3 7M15 14h4"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="language">Language</span>
            <select id="moreMobileLanguage" aria-label="Language">
                <option value="en">English</option>
                <option value="kn">ಕನ್ನಡ</option>
                <option value="hi">हिन्दी</option>
            </select>
        </div>

        <div class="more-mobile-row more-mobile-theme-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2M12 19v2M5.6 5.6 7 7M17 17l1.4 1.4M3 12h2M19 12h2M5.6 18.4 7 17"/><circle cx="12" cy="12" r="3.5"/><path d="M18.5 5.5a6.8 6.8 0 0 1-9 9 6.8 6.8 0 0 0 9-9Z"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="theme">Theme</span>
            <div class="more-mobile-theme-switch" role="group" aria-label="Theme">
                <button type="button" data-theme-choice="light" data-i18n="light">Light</button>
                <button type="button" data-theme-choice="dark" data-i18n="dark">Dark</button>
            </div>
        </div>

        <a href="#" class="more-mobile-row">
            <span class="more-mobile-row-icon">⚙</span>
            <span class="more-mobile-row-label" data-i18n="settings">Settings</span>
            <span class="more-mobile-chevron">›</span>
        </a>

        <a asp-controller="Profile" asp-action="UnlimitedPlan" class="more-mobile-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 8.5c-2.8 0-4.5 2.2-4.5 3.5s1.7 3.5 4.5 3.5c4.5 0 4.5-7 9-7 2.8 0 4.5 2.2 4.5 3.5s-1.7 3.5-4.5 3.5c-4.5 0-4.5-7-9-7Z"/></svg></span>
            <span class="more-mobile-row-label">Unlimited Plan</span>
            <span class="more-mobile-chevron">›</span>
        </a>

        <button type="button"
                class="more-mobile-row more-mobile-support-trigger"
                id="moreMobileSupportTrigger"
                aria-haspopup="dialog"
                aria-controls="moreMobileSupportModal">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><path d="M4 13h3v6H5a1 1 0 0 1-1-1v-5ZM20 13h-3v6h2a1 1 0 0 1 1-1v-5Z"/><path d="M9 20h3a2 2 0 0 0 2-2"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="customerSupport">Customer Support</span>
            <span class="more-mobile-chevron">›</span>
        </button>

        <a asp-controller="Profile" asp-action="Feedback" class="more-mobile-row">
            <span class="more-mobile-row-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4H6.5A2.5 2.5 0 0 1 4 13.5v-8Z"/><path d="M8 8h8M8 11h5"/></svg></span>
            <span class="more-mobile-row-label" data-i18n="feedbackForUs">Feedback for Us</span>
            <span class="more-mobile-chevron">›</span>
        </a>

        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" data-online-required="true" class="more-mobile-signout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="more-mobile-signout" data-i18n="signOut">Sign out</button>
        </form>
    </section>

    <div class="more-mobile-legal">
        <a href="#">Terms and Conditions</a>
        <a href="#">Privacy Policy</a>
    </div>

    <div class="more-support-modal" id="moreMobileSupportModal" hidden>
        <div class="more-support-modal-backdrop" data-support-close></div>

        <section class="more-support-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="moreSupportTitle">
            <button type="button"
                    class="more-support-close"
                    data-support-close
                    data-i18n-attr="aria-label:closeSupportOptions">
                <span aria-hidden="true">&times;</span>
            </button>

            <div class="more-support-dialog-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6.5 4.5h11A2.5 2.5 0 0 1 20 7v7a2.5 2.5 0 0 1-2.5 2.5h-5.2L8 20v-3.5H6.5A2.5 2.5 0 0 1 4 14V7a2.5 2.5 0 0 1 2.5-2.5Z"/>
                    <path d="M8 9h8M8 12h5"/>
                </svg>
            </div>

            <h2 id="moreSupportTitle" data-i18n="supportPopupTitle">How would you like to contact us?</h2>
            <p data-i18n="supportPopupDescription">
                Choose a contact method. Your PharmaFlow account details will be included automatically.
            </p>

            <div class="more-support-actions">
                <a asp-controller="Support"
                   asp-action="WhatsApp"
                   class="more-support-option more-support-whatsapp">
                    <span class="more-support-option-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M20 11.5a8 8 0 0 1-11.9 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/>
                            <path d="M8.7 8.4c.2-.5.4-.5.8-.5h.4c.2 0 .4.1.5.4l.6 1.4c.1.3.1.5-.1.7l-.5.6c-.1.2-.2.3 0 .6.3.5 1.2 1.7 2.8 2.3.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.7-.1l1.3.6c.3.1.4.3.3.6-.2.7-.8 1.4-1.5 1.6-.4.1-.9.2-1.5 0-2.8-.7-5.7-3.5-6.1-4.4-.4-.8-.7-1.9-.1-3Z"/>
                        </svg>
                    </span>
                    <span>
                        <strong data-i18n="chatOnWhatsApp">Chat on WhatsApp</strong>
                        <small>+91 96116 78864</small>
                    </span>
                    <span class="more-support-option-arrow" aria-hidden="true">›</span>
                </a>

                <a asp-controller="Support"
                   asp-action="Email"
                   class="more-support-option more-support-email">
                    <span class="more-support-option-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="5.5" width="17" height="13" rx="2"/>
                            <path d="m5 7 7 5 7-5"/>
                        </svg>
                    </span>
                    <span>
                        <strong data-i18n="emailUs">Email Us</strong>
                        <small>mahammadjouhar@gmail.com</small>
                    </span>
                    <span class="more-support-option-arrow" aria-hidden="true">›</span>
                </a>

                <button type="button"
                        class="more-support-cancel"
                        data-support-close
                        data-i18n="cancel">
                    Cancel
                </button>
            </div>
        </section>
    </div>
</div>

<div class="profile-page">
    <div class="profile-header">
        <div>
            <span class="dashboard-eyebrow" data-i18n="account">Account</span>
            <h1 class="dashboard-title" data-i18n="myProfile">My Profile</h1>
            <p class="dashboard-subtitle" data-i18n="manageAccount">Manage your account and pharmacy details.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-light profile-back" data-i18n="backToDashboard">Back to dashboard</a>
    </div>

    @if (TempData["ProfileMessage"] is string message)
    {
        <div class="alert alert-success border-0 shadow-sm" data-i18n-message="profileUpdated">@message</div>
    }

    <div class="profile-card dashboard-card">
        <div class="profile-card-head">
            <div class="profile-avatar-large">@((Model.Username.Length > 0 ? Model.Username[0] : 'U').ToString().ToUpperInvariant())</div>
            <div>
                <h2>@Model.Username</h2>
                <p>@Model.Email</p>
            </div>
        </div>

        <form asp-action="Index" method="post" class="profile-form" data-online-required="true">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="profile-form-grid">
                <div>
                    <label asp-for="BusinessName" class="form-label" data-i18n="businessNameField"></label>
                    <input asp-for="BusinessName" class="form-control" maxlength="120" />
                    <span asp-validation-for="BusinessName" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Username" class="form-label" data-i18n="usernameField"></label>
                    <input asp-for="Username" class="form-control" maxlength="50" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="form-label" data-i18n="phoneNumberField"></label>
                    <input asp-for="PhoneNumber" class="form-control" maxlength="20" autocomplete="tel" placeholder="Enter mobile number" data-i18n-placeholder="phonePlaceholder" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Email" class="form-label" data-i18n="emailField"></label>
                    <input asp-for="Email" class="form-control" readonly />
                    <small class="text-muted" data-i18n="emailManagedByProvider">Email is managed by your sign-in provider.</small>
                </div>
            </div>

            <div class="profile-actions">
                <button type="submit" class="btn btn-primary px-4" data-i18n="saveChanges">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const language = document.getElementById('moreMobileLanguage');
            if (!language) return;

            const current = localStorage.getItem('pharmaflow-language') || 'en';
            language.value = current;

            language.addEventListener('change', () => {
                const selected = language.value;
                localStorage.setItem('pharmaflow-language', selected);
                window.pharmaFlowLanguage?.apply(selected);
            });

            window.addEventListener('storage', () => {
                const selected = localStorage.getItem('pharmaflow-language') || 'en';
                language.value = selected;
            });
        })();
    </script>
    <script>
        (() => {
            const trigger = document.getElementById('moreMobileSupportTrigger');
            const modal = document.getElementById('moreMobileSupportModal');
            if (!trigger || !modal) return;

            let lastFocused = null;

            const setOpen = (open) => {
                modal.hidden = !open;
                document.body.classList.toggle('support-modal-open', open);

                if (open) {
                    lastFocused = document.activeElement;
                    modal.querySelector('.more-support-close')?.focus();
                } else {
                    lastFocused?.focus?.();
                }
            };

            trigger.addEventListener('click', () => setOpen(true));

            modal.querySelectorAll('[data-support-close]').forEach(element => {
                element.addEventListener('click', () => setOpen(false));
            });

            modal.querySelectorAll('.more-support-option').forEach(link => {
                link.addEventListener('click', () => setOpen(false));
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && !modal.hidden) {
                    setOpen(false);
                }
            });
        })();
    </script>
}
