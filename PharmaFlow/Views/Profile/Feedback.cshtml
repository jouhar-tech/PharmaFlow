@model PharmaFlow.Models.ViewModels.FeedbackViewModel
@{
    ViewData["Title"] = "Feedback";
}

<style>
    .feedback-mobile-page { display: none; }

    @@media (max-width: 767.98px) {
        .feedback-mobile-page {
            display: block;
            min-height: calc(100vh - 76px);
            padding-bottom: 5.5rem;
            background: #f4f7f8;
            margin: 0 -0.75rem;
        }

        .feedback-mobile-header {
            min-height: 112px;
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: 1.15rem 1rem 1.25rem;
            background: linear-gradient(135deg, #b8f1df 0%, #9fe6d2 100%);
            border-radius: 0 0 22px 22px;
        }

        .feedback-mobile-back {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            flex: 0 0 38px;
            color: #1f2937;
            text-decoration: none;
        }

        .feedback-mobile-back svg {
            width: 25px;
            height: 25px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .feedback-mobile-header h1 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 750;
            letter-spacing: -.025em;
            color: #1f2937;
        }

        .feedback-mobile-content {
            padding: 1.15rem 1rem 0;
        }

        .feedback-mobile-section-title {
            margin: 0 0 .7rem;
            color: #17251f;
            font-size: 1.2rem;
            line-height: 1.2;
            font-weight: 750;
        }

        .feedback-mobile-rating-card {
            padding: 1.05rem 1rem 1rem;
            margin-bottom: 1.5rem;
            background: #fff;
            border: 1px solid #e4e9e8;
            border-radius: 17px;
            box-shadow: 0 6px 18px rgba(15, 23, 42, .07);
        }

        .feedback-mobile-rating-card h2 {
            margin: 0 0 .8rem;
            font-size: 1.35rem;
            font-weight: 750;
            color: #18221e;
        }

        .feedback-mobile-stars {
            display: flex;
            justify-content: space-between;
            gap: .35rem;
        }

        .feedback-mobile-star-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .feedback-mobile-star-label {
            cursor: pointer;
            color: #9ddbc9;
            font-size: 3.25rem;
            line-height: .95;
            transition: transform .15s ease, color .15s ease;
        }

        .feedback-mobile-star-label:hover { transform: translateY(-2px); }
        .feedback-mobile-star-input:checked + .feedback-mobile-star-label { color: #53c5a7; }
        .feedback-mobile-star-input:focus-visible + .feedback-mobile-star-label {
            outline: 2px solid #2563eb;
            outline-offset: 3px;
            border-radius: 5px;
        }

        .feedback-mobile-field-label {
            display: block;
            margin-bottom: .65rem;
            color: #17251f;
            font-size: 1.2rem;
            font-weight: 750;
        }

        .feedback-mobile-textarea {
            width: 100%;
            min-height: 172px;
            resize: vertical;
            padding: .9rem 1rem;
            background: #fff;
            border: 1px solid #aab5b2;
            border-radius: 13px;
            color: #1f2937;
            font-size: 1rem;
            line-height: 1.5;
            box-shadow: none;
        }

        .feedback-mobile-textarea::placeholder { color: #7a817f; }
        .feedback-mobile-textarea:focus {
            outline: none;
            border-color: #53c5a7;
            box-shadow: 0 0 0 3px rgba(83, 197, 167, .14);
        }

        .feedback-mobile-tags-title {
            margin-top: 1.35rem;
        }

        .feedback-mobile-tags {
            display: flex;
            flex-wrap: wrap;
            gap: .55rem;
        }

        .feedback-mobile-tag-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .feedback-mobile-tag {
            display: inline-flex;
            align-items: center;
            min-height: 40px;
            padding: .4rem .85rem;
            border: 1px solid #72cdb5;
            border-radius: 999px;
            background: #e5f7f1;
            color: #263b34;
            font-size: .88rem;
            cursor: pointer;
            transition: background .15s ease, color .15s ease, border-color .15s ease, transform .15s ease;
        }

        .feedback-mobile-tag:hover { transform: translateY(-1px); }
        .feedback-mobile-tag-input:checked + .feedback-mobile-tag {
            background: #53c5a7;
            border-color: #53c5a7;
            color: #fff;
        }

        .feedback-mobile-submit {
            width: 100%;
            min-height: 54px;
            margin-top: 1.45rem;
            border: 0;
            border-radius: 9px;
            background: #1769c2;
            color: #fff;
            font-size: 1.15rem;
            font-weight: 650;
            box-shadow: 0 5px 12px rgba(23, 105, 194, .2);
            transition: transform .15s ease, background .15s ease;
        }

        .feedback-mobile-submit:active { transform: scale(.985); }
        .feedback-mobile-submit:hover { background: #145ca8; }

        .feedback-mobile-validation {
            margin: .65rem 0 0;
            font-size: .8rem;
        }

        .feedback-mobile-success {
            margin: 1rem;
            padding: .8rem .9rem;
            border-radius: 11px;
            background: #e8f8f1;
            border: 1px solid #a7dfcc;
            color: #17634f;
            font-size: .85rem;
        }

        .feedback-mobile-page + .profile-page { display: none; }
    }
</style>

<div class="feedback-mobile-page">
    <header class="feedback-mobile-header">
        <a asp-controller="Profile" asp-action="Index" class="feedback-mobile-back" aria-label="Back">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m11 18-6-6 6-6"></path>
            </svg>
        </a>
        <h1>Feedback</h1>
    </header>

    @if (TempData["FeedbackMessage"] is string mobileMessage)
    {
        <div class="feedback-mobile-success">@mobileMessage</div>
    }

    <form asp-action="Feedback" method="post" data-online-required="true">
        @Html.AntiForgeryToken()

        <div class="feedback-mobile-content">
            <h2 class="feedback-mobile-section-title">Rating</h2>
            <div class="feedback-mobile-rating-card">
                <h2>Rate Your Experience</h2>
                <div class="feedback-mobile-stars" role="radiogroup" aria-label="Rate your experience">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <input class="feedback-mobile-star-input" type="radio" asp-for="Rating" value="@star" id="feedback-star-@star" />
                        <label class="feedback-mobile-star-label" for="feedback-star-@star" aria-label="@star star">★</label>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger feedback-mobile-validation"></span>
            </div>

            <label asp-for="Message" class="feedback-mobile-field-label">Detailed Feedback</label>
            <textarea asp-for="Message" class="feedback-mobile-textarea" maxlength="2000" placeholder="Write your experience here"></textarea>
            <span asp-validation-for="Message" class="text-danger feedback-mobile-validation"></span>

            <h2 class="feedback-mobile-section-title feedback-mobile-tags-title">Quick Tags</h2>
            <div class="feedback-mobile-tags">
                @{
                    var quickTags = new[] { "Usability", "App Design", "Performance", "Customer Support", "Features" };
                }
                @foreach (var tag in quickTags)
                {
                    var tagId = "feedback-tag-" + tag.Replace(" ", "-").ToLowerInvariant();
                    var selected = Model.SelectedTags.Contains(tag, StringComparer.Ordinal);
                    <input class="feedback-mobile-tag-input" type="checkbox" name="SelectedTags" value="@tag" id="@tagId" @(selected ? "checked" : null) />
                    <label class="feedback-mobile-tag" for="@tagId">@tag</label>
                }
            </div>

            <button type="submit" class="feedback-mobile-submit">Submit Feedback</button>
        </div>
    </form>
</div>

<div class="profile-page">
    <div class="profile-header">
        <div>
            <span class="dashboard-eyebrow" data-i18n="helpSupport">Help & Support</span>
            <h1 class="dashboard-title" data-i18n="sendFeedback">Send Feedback</h1>
            <p class="dashboard-subtitle" data-i18n="tellUsBetter">Tell us what would make PharmaFlow better for your pharmacy.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-light profile-back" data-i18n="backToDashboard">Back to dashboard</a>
    </div>

    @if (TempData["FeedbackMessage"] is string message)
    {
        <div class="alert alert-success border-0 shadow-sm" data-i18n-message="feedbackSubmitted">@message</div>
    }

    <div class="profile-card dashboard-card feedback-card">
        <div class="feedback-icon">💬</div>
        <h2 data-i18n="wedLikeToHear">We'd like to hear from you</h2>
        <p class="text-muted" data-i18n="feedbackDescription">Share a suggestion, report an issue, or tell us what you would like to see next.</p>

        <form asp-action="Feedback" method="post" class="text-start feedback-form-placeholder" data-online-required="true">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="Message" class="form-label fw-semibold" data-i18n="yourFeedback">Your feedback</label>
            <textarea asp-for="Message" class="form-control" rows="6" maxlength="2000"
                      placeholder="Write your feedback here..." data-i18n-placeholder="feedbackPlaceholder"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>

            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary px-4" data-i18n="sendFeedback">Send Feedback</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
