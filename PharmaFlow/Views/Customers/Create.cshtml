@model PharmaFlow.Models.ViewModels.CustomerCreateViewModel
@{
    ViewData["Title"] = "Add Customer";
}

<div class="customer-form-page">
    <header class="customer-form-header">
        <a asp-controller="Customers" asp-action="Index" class="customer-back-button" aria-label="Back to customer management">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/><path d="M9 12h11"/></svg>
        </a>
        <div>
            <div class="customer-page-eyebrow">Customer Accounts</div>
            <h1>Add Customer</h1>
            <p>Create a customer profile and optionally record an opening Udhaar balance.</p>
        </div>
    </header>

    <form asp-controller="Customers" asp-action="Create" method="post" class="customer-form-card" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="customer-validation-summary"></div>

        <div class="customer-form-section-title">
            <span class="customer-form-section-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.8-3.3 3-5 6.5-5s5.7 1.7 6.5 5"/></svg>
            </span>
            <div>
                <h2>Customer Information</h2>
                <p>Use a mobile number when available so the customer can be found quickly later.</p>
            </div>
        </div>

        <div class="customer-form-grid">
            <div class="customer-form-field customer-form-field-wide">
                <label asp-for="FullName">Customer Name <span>*</span></label>
                <input asp-for="FullName" class="customer-form-input" autocomplete="name" maxlength="120" placeholder="Enter customer name" />
                <span asp-validation-for="FullName" class="customer-field-error"></span>
            </div>

            <div class="customer-form-field">
                <label asp-for="PhoneNumber">Phone Number</label>
                <input asp-for="PhoneNumber"
                       class="customer-form-input"
                       type="tel"
                       inputmode="numeric"
                       maxlength="15"
                       autocomplete="tel"
                       placeholder="10-digit mobile number" />
                <small>Optional, but recommended for faster billing lookup.</small>
                <span asp-validation-for="PhoneNumber" class="customer-field-error"></span>
            </div>

            <div class="customer-form-field">
                <label asp-for="OpeningBalance">Udhaar Amount</label>
                <div class="customer-money-input">
                    <span>₹</span>
                    <input asp-for="OpeningBalance"
                           class="customer-form-input"
                           type="number"
                           min="0"
                           max="1000000000"
                           step="0.01"
                           inputmode="decimal"
                           placeholder="0.00" />
                </div>
                <small>Enter 0 to create the customer without an opening balance.</small>
                <span asp-validation-for="OpeningBalance" class="customer-field-error"></span>
            </div>

            <div class="customer-form-field customer-form-field-wide">
                <label>Balance Direction</label>
                <div class="customer-balance-choice-group">
                    <label class="customer-balance-choice">
                        <input asp-for="BalanceType" type="radio" value="OwedToYou" />
                        <span>
                            <strong>Owed to you</strong>
                            <small>The customer owes this amount to your pharmacy.</small>
                        </span>
                    </label>
                    <label class="customer-balance-choice">
                        <input asp-for="BalanceType" type="radio" value="OwedByYou" />
                        <span>
                            <strong>Owed by you</strong>
                            <small>Your pharmacy owes this amount to the customer.</small>
                        </span>
                    </label>
                </div>
            </div>

            <div class="customer-form-field customer-form-field-wide">
                <label asp-for="Note">Note</label>
                <textarea asp-for="Note"
                          class="customer-form-input customer-form-textarea"
                          maxlength="500"
                          rows="3"
                          placeholder="Optional note, for example: Opening balance carried forward"></textarea>
                <small>Keep a short reference for why an opening balance was added.</small>
                <span asp-validation-for="Note" class="customer-field-error"></span>
            </div>
        </div>

        <div class="customer-form-safety-note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 20 7v5.2c0 4.1-3.1 7.6-8 8.8-4.9-1.2-8-4.7-8-8.8V7z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
            <div>
                <strong>Udhaar tracking is automatic</strong>
                <span>When you generate a bill using <b>Udhaar</b>, the bill amount is added to the linked customer's balance automatically.</span>
            </div>
        </div>

        <div class="customer-form-actions">
            <a asp-controller="Customers" asp-action="Index" class="customer-cancel-button">Cancel</a>
            <button type="submit" class="customer-primary-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                <span>Save Customer</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
