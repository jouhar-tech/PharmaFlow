@model PharmaFlow.Models.ViewModels.AddStaffViewModel
@{
    var staffMembers = ViewBag.StaffMembers as List<PharmaFlow.Models.Staff> ?? new List<PharmaFlow.Models.Staff>();
    var showAddForm = ViewBag.ShowAddForm is bool showForm && showForm;
    ViewData["Title"] = showAddForm ? "Add Staff" : "Staff";
}

<div class="add-staff-mobile-page">
    <header class="add-staff-mobile-hero @(showAddForm ? "" : "staff-list-hero")">
        <a asp-controller="@(showAddForm && staffMembers.Count > 0 ? "Staff" : "Profile")"
           asp-action="@(showAddForm && staffMembers.Count > 0 ? "Add" : "Index")"
           class="add-staff-mobile-back" aria-label="Back">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
        </a>
        <h1>@(showAddForm ? "Add Staff" : "Staff")</h1>
        @if (!showAddForm)
        {
            <a asp-action="Add" asp-route-newStaff="true" class="add-staff-add-another-btn" data-i18n="addAnotherStaff">+ Add another staff</a>
        }
    </header>

    @if (TempData["StaffMessage"] is string staffMessage)
    {
        <div class="add-staff-success" role="status" aria-live="polite">
            <strong>@(staffMessage.Contains("removed", StringComparison.OrdinalIgnoreCase) ? "Staff removed successfully" : "Staff added successfully")</strong>
            <span>@staffMessage</span>
        </div>
    }

    @if (TempData["StaffError"] is string staffError)
    {
        <div class="add-staff-error" role="alert">@staffError</div>
    }

    @if (!showAddForm)
    {
        <section class="staff-roster" aria-labelledby="staffRosterTitle">
            <div class="staff-roster-heading">
                <div>
                    <h2 id="staffRosterTitle">Current staff</h2>
                    <p>Manage the people who can access this pharmacy.</p>
                </div>
                <span class="staff-roster-count">@staffMembers.Count active</span>
            </div>

            <div class="staff-roster-list">
                @foreach (var staff in staffMembers)
                {
                    <article class="staff-roster-card">
                        <div class="staff-roster-avatar">
                            @if (!string.IsNullOrWhiteSpace(staff.ProfilePhotoUrl))
                            {
                                <img src="@staff.ProfilePhotoUrl" alt="@staff.FullName" loading="lazy" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(staff.FullName) ? "S" : staff.FullName.Trim().Substring(0, 1).ToUpperInvariant())</span>
                            }
                        </div>

                        <div class="staff-roster-details">
                            <div class="staff-roster-name-row">
                                <h3>@staff.FullName</h3>
                                <span class="staff-active-status">Active</span>
                            </div>
                            <p class="staff-roster-username">Username: <strong>@staff.Username</strong></p>
                            @if (!string.IsNullOrWhiteSpace(staff.PhoneNumber))
                            {
                                <p><span>Phone</span> @staff.PhoneNumber</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(staff.Email))
                            {
                                <p><span>Email</span> @staff.Email</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(staff.Address))
                            {
                                <p><span>Address</span> @staff.Address</p>
                            }
                            <small>Added @staff.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                            <form asp-action="Remove" method="post" class="staff-remove-form"
                                  onsubmit="return confirm('Remove this staff member from the pharmacy? Their sign-in access will be disabled.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="staffId" value="@staff.StaffId" />
                                <button type="submit" class="staff-remove-button">Remove staff</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    else
    {
        <form asp-action="Add" method="post" enctype="multipart/form-data" class="add-staff-mobile-form" autocomplete="off" data-online-required="true">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="add-staff-validation"></div>
    
            <div class="add-staff-photo-wrap">
                <div class="add-staff-photo">
                    <img id="staffPhotoPreview" alt="Profile photo preview" hidden />
                    <svg id="staffPhotoPlaceholder" class="add-staff-photo-placeholder" viewBox="0 0 64 64" aria-hidden="true">
                        <circle cx="32" cy="24" r="11"></circle>
                        <path d="M12 54c2.5-10 10.2-16 20-16s17.5 6 20 16"></path>
                    </svg>
                </div>
                <label for="staffProfilePhoto" class="add-staff-photo-action" aria-label="Upload profile photo" title="Upload profile photo">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 8.5A2.5 2.5 0 0 1 6.5 6H9l1.5-2h3L15 6h2.5A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z"></path>
                        <circle cx="12" cy="12.5" r="3.2"></circle>
                        <path d="M18 9h.01"></path>
                    </svg>
                    <span class="add-staff-upload-plus">+</span>
                </label>
                <input asp-for="ProfilePhoto" id="staffProfilePhoto" type="file" accept="image/jpeg,image/png,image/webp" class="add-staff-photo-input" />
                <div class="add-staff-photo-label" data-i18n="profilePhoto">Profile Photo</div>
            </div>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 20a5 5 0 0 0-2-3.9"/></svg></span>
                <input asp-for="FullName" data-i18n-placeholder="fullName" placeholder="Full Name" autocomplete="name" maxlength="120" />
            </div>
            <span asp-validation-for="FullName" class="add-staff-field-error"></span>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11A7 7 0 0 0 5 10c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg></span>
                <input asp-for="Address" data-i18n-placeholder="address" placeholder="Address" autocomplete="street-address" maxlength="500" />
            </div>
            <span asp-validation-for="Address" class="add-staff-field-error"></span>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 11.2 18a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.2 3.2 2 2 0 0 1 4.2 1h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.9L7.3 9.4a16 16 0 0 0 7.3 7.3l1.8-1.8a2 2 0 0 1 1.9-.6l3 .5a2 2 0 0 1 .7 2.1Z"/></svg></span>
                <input asp-for="PhoneNumber" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" autocomplete="tel-national" placeholder="10-digit Phone Number (optional if email entered)" aria-describedby="staffContactHint" />
            </div>
            <span asp-validation-for="PhoneNumber" class="add-staff-field-error"></span>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 5 8-5"/></svg></span>
                <input asp-for="Email" type="email" autocomplete="email" maxlength="160" placeholder="Email Address (optional if phone entered)" aria-describedby="staffContactHint" />
            </div>
            <span asp-validation-for="Email" class="add-staff-field-error"></span>
            <small id="staffContactHint" class="add-staff-login-hint">Enter a 10-digit phone number (numbers only), an email address, or both. Staff can log in using either saved contact and their password.</small>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 20a5 5 0 0 0-2-3.9"/></svg></span>
                <input asp-for="Password" type="password" id="staffPassword" placeholder="Password" autocomplete="new-password" />
                <button type="button" class="add-staff-password-toggle" data-target="staffPassword" aria-label="Show password">◉</button>
            </div>
            <span asp-validation-for="Password" class="add-staff-field-error"></span>
    
            <div class="add-staff-field">
                <span class="add-staff-field-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 20a5 5 0 0 0-2-3.9"/></svg></span>
                <input asp-for="ConfirmPassword" type="password" id="staffConfirmPassword" placeholder="Confirm Password" autocomplete="new-password" />
                <button type="button" class="add-staff-password-toggle" data-target="staffConfirmPassword" aria-label="Show password">◉</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="add-staff-field-error"></span>
    
            <button type="submit" class="add-staff-save" data-i18n="save">Save</button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .staff-list-hero {
            grid-template-columns: 40px minmax(0, 1fr) auto;
            align-items: center;
            gap: 8px;
        }
        .staff-list-hero h1 {
            min-width: 0;
            font-size: 1.35rem;
            white-space: nowrap;
        }
        .add-staff-add-another-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 8px 10px;
            border-radius: 12px;
            background: #087f74;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.2;
            text-align: center;
            text-decoration: none;
            white-space: nowrap;
        }
        .staff-roster {
            width: calc(100% - 1.6rem);
            margin: 14px auto 0;
            padding-bottom: 24px;
        }
        .staff-roster-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }
        .staff-roster-heading h2 {
            margin: 0;
            color: #172a29;
            font-size: 18px;
            font-weight: 850;
        }
        .staff-roster-heading p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.4;
        }
        .staff-roster-count {
            flex-shrink: 0;
            padding: 7px 10px;
            border-radius: 999px;
            background: #d8f3ec;
            color: #086b60;
            font-size: 11px;
            font-weight: 800;
        }
        .staff-roster-list {
            display: grid;
            gap: 11px;
        }
        .staff-roster-card {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px;
            border: 1px solid #e1e8ed;
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 3px 14px rgba(15, 23, 42, .04);
        }
        .staff-roster-avatar {
            display: grid;
            flex: 0 0 46px;
            width: 46px;
            height: 46px;
            place-items: center;
            overflow: hidden;
            border-radius: 14px;
            background: #dff5ef;
            color: #087f74;
            font-size: 20px;
            font-weight: 850;
        }
        .staff-roster-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .staff-roster-details {
            min-width: 0;
            flex: 1;
        }
        .staff-roster-name-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 7px;
        }
        .staff-roster-name-row h3 {
            margin: 0;
            color: #172a29;
            font-size: 15px;
            font-weight: 850;
            overflow-wrap: anywhere;
        }
        .staff-active-status {
            padding: 3px 7px;
            border-radius: 999px;
            background: #e5f8ef;
            color: #18794e;
            font-size: 10px;
            font-weight: 800;
        }
        .staff-roster-details p {
            margin: 7px 0 0;
            color: #334155;
            font-size: 12px;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }
        .staff-roster-details p span {
            color: #64748b;
            font-weight: 650;
            margin-right: 4px;
        }
        .staff-roster-details .staff-roster-username {
            color: #475569;
        }
        .staff-roster-details small {
            display: block;
            margin-top: 9px;
            color: #64748b;
            font-size: 11px;
        }
        .staff-remove-form {
            margin-top: 12px;
        }
        .staff-remove-button {
            min-height: 36px;
            padding: 8px 12px;
            border: 1px solid #fecaca;
            border-radius: 10px;
            background: #fff7f7;
            color: #b42318;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }
        .add-staff-error {
            margin: 12px 10px 16px;
            padding: 12px 14px;
            border: 1px solid #fecaca;
            border-radius: 12px;
            background: #fff1f1;
            color: #b42318;
            font-size: 13px;
            font-weight: 650;
        }
        @@media (max-width: 360px) {
            .staff-list-hero { grid-template-columns: 32px minmax(0, 1fr) auto; gap: 4px; padding-left: .55rem; padding-right: .55rem; }
            .staff-list-hero h1 { font-size: 1.15rem; }
            .add-staff-add-another-btn { padding: 7px 8px; font-size: 11px; }
            .staff-roster-card { padding: 11px; gap: 9px; }
        }
        .add-staff-validation,
        .add-staff-field-error,
        .add-staff-mobile-form .validation-summary-errors,
        .add-staff-mobile-form .field-validation-error {
            color: #c62828 !important;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.45;
        }
        .add-staff-validation:empty { display: none; }
        .add-staff-validation ul,
        .add-staff-mobile-form .validation-summary-errors ul {
            margin: 0 0 12px;
            padding: 10px 12px 10px 28px;
            border: 1px solid #f1a5a5;
            border-radius: 10px;
            background: #fff1f1;
        }
        .add-staff-field-error {
            display: block;
            margin: -7px 4px 8px;
        }
        .add-staff-success {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin: 12px 10px 16px;
            padding: 12px 14px;
            border: 1px solid #9bd9c4;
            border-radius: 12px;
            background: #eaf8f1;
            color: #176548;
            font-size: 14px;
        }
        .add-staff-success strong { font-weight: 700; }
    </style>
    <script>
        const photoInput = document.getElementById('staffProfilePhoto');
        const photoPreview = document.getElementById('staffPhotoPreview');
        const photoPlaceholder = document.getElementById('staffPhotoPlaceholder');

        photoInput?.addEventListener('change', () => {
            const file = photoInput.files?.[0];
            if (!file) return;
            if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 5 * 1024 * 1024) {
                photoInput.value = '';
                alert('Please select a JPG, PNG or WebP image up to 5 MB.');
                return;
            }
            const reader = new FileReader();
            reader.onload = event => {
                photoPreview.src = event.target.result;
                photoPreview.hidden = false;
                photoPlaceholder.hidden = true;
            };
            reader.readAsDataURL(file);
        });

        document.querySelectorAll('.add-staff-password-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                if (!input) return;
                const visible = input.type === 'text';
                input.type = visible ? 'password' : 'text';
                button.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
            });
        });
    </script>
}
