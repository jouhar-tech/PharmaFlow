<!DOCTYPE html>
@{
    var businessName = Context.Session.GetString("BusinessName") ?? "PharmaFlow";
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @businessName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmaFlow.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                    <span class="brand-mark">✚</span>
                    <span class="brand-name">@businessName</span>
                </a>
                <button class="sidebar-close d-lg-none" type="button" id="sidebarClose" aria-label="Close navigation">&times;</button>
            </div>

            <div class="sidebar-caption">Workspace</div>
            <nav class="sidebar-nav">
                <a class="sidebar-link active" asp-area="" asp-controller="Home" asp-action="Index"><span class="sidebar-icon">▦</span><span>Dashboard</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">↗</span><span>Top Selling / Low Selling</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">▤</span><span>Low Stock Details</span><span class="sidebar-badge">Voice</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">⌛</span><span>Expiring Details</span><span class="sidebar-badge">Voice</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">▥</span><span>Daily Sales Reports</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">♙</span><span>Customer Management</span><span class="sidebar-badge">Voice</span></a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link sidebar-logout-button"><span class="sidebar-icon">↪</span><span>Log Out</span></button>
                </form>
                <a class="sidebar-link" href="#"><span class="sidebar-icon">⚙</span><span>Settings</span><span class="sidebar-badge">Category / Shop</span></a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-label">Pharmacy management</div>
                <small>More modules will be enabled as backend features are added.</small>
            </div>
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <div class="app-main">
            <header class="app-topbar">
                <button class="sidebar-toggle d-lg-none" type="button" id="sidebarToggle" aria-label="Open navigation">☰</button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="profile-menu">
                    <button type="button" class="profile-trigger" id="profileTrigger" aria-expanded="false" aria-controls="profileMenu">
                        <span class="profile-avatar">@((Context.Session.GetString("Username") ?? businessName).FirstOrDefault().ToString().ToUpperInvariant())</span>
                        <span class="profile-trigger-text">
                            <strong>@businessName</strong>
                            <small>@(Context.Session.GetString("Username") ?? "Account")</small>
                        </span>
                        <span class="profile-chevron">⌄</span>
                    </button>
                    <div class="profile-dropdown" id="profileMenu" hidden>
                        <div class="profile-dropdown-head">
                            <span class="profile-avatar profile-avatar-sm">@((Context.Session.GetString("Username") ?? businessName).FirstOrDefault().ToString().ToUpperInvariant())</span>
                            <div>
                                <strong>@(Context.Session.GetString("Username") ?? "Account")</strong>
                                <small>@businessName</small>
                            </div>
                        </div>
                        <div class="profile-dropdown-divider"></div>
                        <a asp-controller="Profile" asp-action="Index" class="profile-menu-item"><span>👤</span><span>Edit Profile</span></a>
                        <button type="button" class="profile-menu-item profile-appearance-toggle" id="appearanceToggle"><span>◐</span><span>Appearance</span><span class="menu-item-arrow">›</span></button>
                        <div class="appearance-panel" id="appearancePanel" hidden>
                            <button type="button" data-theme-choice="light">Light</button>
                            <button type="button" data-theme-choice="dark">Dark</button>
                            <button type="button" data-theme-choice="system">System</button>
                        </div>
                        <a asp-controller="Profile" asp-action="Feedback" class="profile-menu-item"><span>💬</span><span>Send Feedback</span></a>
                        <div class="profile-dropdown-divider"></div>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="profile-menu-item profile-menu-logout"><span>↪</span><span>Log Out</span></button>
                        </form>
                    </div>
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 - @businessName</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const toggle = document.getElementById('sidebarToggle');
            const close = document.getElementById('sidebarClose');
            const setOpen = (open) => {
                sidebar?.classList.toggle('is-open', open);
                overlay?.classList.toggle('is-visible', open);
                document.body.classList.toggle('sidebar-open', open);
            };
            toggle?.addEventListener('click', () => setOpen(true));
            close?.addEventListener('click', () => setOpen(false));
            overlay?.addEventListener('click', () => setOpen(false));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
