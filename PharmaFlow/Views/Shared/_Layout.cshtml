<!DOCTYPE html>
@{
    var businessName = Context.Session.GetString("BusinessName") ?? "PharmaFlow";
    var isHomeDashboard = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isExpiryProductsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "ExpiryProducts"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isInventoryPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isMorePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Profile"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isLowStockPage = ViewContext.RouteData.Values["controller"]?.ToString() == "LowStock"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isReportsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Reports"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isStaffAddPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Staff"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Add";
    var isStaffUser = string.Equals(Context.Session.GetString("UserRole"), "Staff", StringComparison.OrdinalIgnoreCase);
    var isUnlimitedPlanPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Profile"
        && ViewContext.RouteData.Values["action"]?.ToString() == "UnlimitedPlan";
    var isFeedbackPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Profile"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Feedback";
    var isBillingCreatePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Billing"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Create";
    var isBillingGeneratedPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Billing"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Generated";
    var isBillsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Bills"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isBillDetailsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Bills"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Details";
    var isCustomersPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Customers"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isCustomerAddPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Customers"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Create";
    var isCustomerDetailsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Customers"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Details";
    var isCustomerPaymentPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Customers"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Payment";
    var isCustomerSectionPage = isCustomersPage || isCustomerAddPage || isCustomerDetailsPage || isCustomerPaymentPage;
    var isInventoryDetailsPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Details";
    var isInventoryActionPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory"
        && new[] { "AddItem", "SearchProducts", "BarcodeScanner" }.Contains(
            ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty,
            StringComparer.OrdinalIgnoreCase);
    var isPurchasePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isPurchaseDistributorPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Distributor";
    var isAdminPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin";
    var isAuthenticated = !string.IsNullOrWhiteSpace(Context.Session.GetString("SupabaseAccessToken"))
        && !string.IsNullOrWhiteSpace(Context.Session.GetString("ProfileId"));
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @businessName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmaFlow.styles.css" asp-append-version="true" />
</head>
<body class="@((isHomeDashboard ? "home-dashboard-page " : "") + (isExpiryProductsPage ? "expiry-products-page " : "") + (isInventoryPage ? "inventory-page " : "") + (isMorePage ? "more-page " : "") + (isLowStockPage ? "low-stock-page " : "") + (isReportsPage ? "reports-page " : "") + (isStaffAddPage ? "staff-add-page " : "") + (isUnlimitedPlanPage ? "unlimited-plan-detail-page " : "") + (isFeedbackPage ? "feedback-page " : "") + (isBillingCreatePage ? "billing-create-page-body " : "") + (isBillingGeneratedPage ? "billing-generated-page-body " : "") + (isBillsPage ? "bills-page-body " : "") + (isBillDetailsPage ? "bill-details-page-body " : "") + (isCustomersPage ? "customer-management-page-body " : "") + (isCustomerAddPage ? "customer-form-page-body " : "") + (isCustomerDetailsPage ? "customer-details-page-body " : "") + (isCustomerPaymentPage ? "customer-payment-page-body " : "") + (isInventoryDetailsPage ? "inventory-details-page-body " : "") + (isInventoryActionPage ? "inventory-action-page-body " : "") + (isPurchasePage ? "purchase-page-body " : "") + (isPurchaseDistributorPage ? "purchase-distributor-page-body " : "") + (isAdminPage ? "admin-page-body " : ""))">
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                    <span class="brand-mark">✚</span>
                    <span class="brand-name">@businessName</span>
                </a>
                <button class="sidebar-close d-lg-none" type="button" id="sidebarClose" data-i18n-attr="aria-label:closeNavigation">&times;</button>
            </div>

            <div class="sidebar-caption" data-i18n="workspace">Workspace</div>
            <nav class="sidebar-nav">
                <a class="sidebar-link active" asp-area="" asp-controller="Home" asp-action="Index"><span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><rect x="14" y="14" width="7" height="7" rx="1.2"/></svg></span><span data-i18n="dashboard">Dashboard</span></a>
                <a class="sidebar-link" asp-controller="ExpiryProducts" asp-action="Index"><span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M7 3v4M17 3v4M3.5 9.5h17"/></svg></span><span data-i18n="expiringDetails">Expiring Details</span><span class="sidebar-badge">Voice</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7"/><path d="M9 15h6"/></svg></span><span data-i18n="lowStockDetails">Low Stock Details</span><span class="sidebar-badge">Voice</span></a>

                <a class="sidebar-link" href="#"><span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1.2a4.5 4.5 0 0 0-4.5-4.5H7.5A4.5 4.5 0 0 0 3 18.8V20"/><circle cx="9.5" cy="7.5" r="3.2"/><path d="M16 4.8a3.2 3.2 0 0 1 0 5.4M21 20v-1.2a4.5 4.5 0 0 0-3.1-4.3"/></svg></span><span data-i18n="customerManagement">Customer Management</span><span class="sidebar-badge">Voice</span></a>
                <a class="sidebar-link" href="#"><span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 15 5-5 4 4 7-8"/><path d="M15 6h5v5"/></svg></span><span data-i18n="topSellingLowSelling">Top Selling / Low Selling</span></a>
@if (!isStaffUser)
                {
                <button type="button" class="sidebar-link sidebar-dropdown-toggle" aria-expanded="false" aria-controls="salesReportsMenu">
                    <span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
                    <span data-i18n="salesReports">Sales Reports</span>
                    <span class="sidebar-menu-arrow">⌄</span>
                </button>
                <div class="sidebar-subnav" id="salesReportsMenu" hidden>
                    <a class="sidebar-sublink" href="#"><span data-i18n="monthlySalesReport">Monthly Sales Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="salesSummaryReport">Sales Summary Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="productWiseSalesReport">Product-wise Sales Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="customerWiseSalesReport">Customer-wise Sales Report</span></a>
                </div>

                <button type="button" class="sidebar-link sidebar-dropdown-toggle" aria-expanded="false" aria-controls="managementReportsMenu">
                    <span class="sidebar-icon"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><rect x="14" y="14" width="7" height="7" rx="1.2"/></svg></span>
                    <span data-i18n="managementReports">Management Reports</span>
                    <span class="sidebar-menu-arrow">⌄</span>
                </button>
                <div class="sidebar-subnav" id="managementReportsMenu" hidden>
                    <a class="sidebar-sublink" href="#"><span data-i18n="stockInventoryReport">Stock / Inventory Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="stockMovementReport">Stock Movement Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="expiryReport">Expiry Report</span></a>
                    <a class="sidebar-sublink" href="#"><span data-i18n="pharmaFlowValueReport">PharmaFlow Value Report</span></a>
                </div>
                }

            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-label" data-i18n="pharmacyManagement">Pharmacy management</div>
                <small data-i18n="moreModules">More modules will be enabled as backend features are added.</small>
            </div>
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <div class="app-main">
            <header class="app-topbar">
                <button class="sidebar-toggle d-lg-none" type="button" id="sidebarToggle" data-i18n-attr="aria-label:openNavigation">☰</button>
                <div class="topbar-title billing-generated-topbar-title" data-page-title-key="@ViewData["Title"]">@ViewData["Title"]</div>
                <div class="profile-menu">
                    <button type="button" class="profile-trigger" id="profileTrigger" aria-expanded="false" aria-controls="profileMenu">
                        <span class="profile-avatar">@((Context.Session.GetString("Username") ?? businessName).FirstOrDefault().ToString().ToUpperInvariant())</span>
                        <span class="profile-trigger-text">
                            <strong>@businessName</strong>
                            <small>@(Context.Session.GetString("Username") ?? "Account")</small>
                        </span>
                        <span class="profile-chevron">⌄</span>
                    </button>
                    <div class="profile-dropdown" id="profileMenu" hidden>
                        <div class="profile-dropdown-head">
                            <span class="profile-avatar profile-avatar-sm">@((Context.Session.GetString("Username") ?? businessName).FirstOrDefault().ToString().ToUpperInvariant())</span>
                            <div>
                                <strong>@(Context.Session.GetString("Username") ?? "Account")</strong>
                                <small>@businessName</small>
                            </div>
                        </div>
                        <div class="profile-dropdown-divider"></div>
                        <a asp-controller="Profile" asp-action="Index" class="profile-menu-item"><span><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1.2a4.5 4.5 0 0 0-4.5-4.5H7.5A4.5 4.5 0 0 0 3 18.8V20"/><circle cx="9.5" cy="7.5" r="3.2"/><path d="M16 4.8a3.2 3.2 0 0 1 0 5.4M21 20v-1.2a4.5 4.5 0 0 0-3.1-4.3"/></svg></span><span data-i18n="editProfile">Edit Profile</span></a>
                        <button type="button" class="profile-menu-item profile-appearance-toggle" id="appearanceToggle" aria-expanded="false"><span><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v2M12 19v2M5.6 5.6 7 7M17 17l1.4 1.4M3 12h2M19 12h2M5.6 18.4 7 17"/><circle cx="12" cy="12" r="3.5"/><path d="M18.5 5.5a6.8 6.8 0 0 1-9 9 6.8 6.8 0 0 0 9-9Z"/></svg></span><span data-i18n="appearance">Appearance</span><span class="menu-item-arrow">›</span></button>
                        <div class="appearance-panel" id="appearancePanel" hidden>
                            <button type="button" data-theme-choice="light" data-i18n="light">Light</button>
                            <button type="button" data-theme-choice="dark" data-i18n="dark">Dark</button>
                            <button type="button" data-theme-choice="system" data-i18n="system">System</button>
                        </div>
                        <button type="button" class="profile-menu-item profile-language-toggle" id="languageToggle" aria-expanded="false"><span><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h9M8.5 3v2M6 8c1.2 3.2 3.4 5.5 7 7M11 8c-1.2 2.8-3.2 5-6 6M14 17l3-7 3 7M15 14h4"/></svg></span><span data-i18n="language">Language</span><span class="menu-item-arrow">›</span></button>
                        <div class="appearance-panel language-panel" id="languagePanel" hidden>
                            <button type="button" data-language-choice="en">English</button>
                            <button type="button" data-language-choice="kn">ಕನ್ನಡ</button>
                            <button type="button" data-language-choice="hi">हिन्दी</button>
                        </div>
                        <a asp-controller="Profile" asp-action="Feedback" class="profile-menu-item"><span>💬</span><span data-i18n="sendFeedback">Send Feedback</span></a>
                        <a class="profile-menu-item" href="#"><span>⚙</span><span data-i18n="settings">Settings</span></a>
                        <div class="profile-dropdown-divider"></div>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" data-online-required="true">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="profile-menu-item profile-menu-logout"><span>↪</span><span data-i18n="logOut">Log Out</span></button>
                        </form>
                    </div>
                </div>
            </header>

            <div class="pharmaflow-connectivity-banner" id="pharmaflowConnectivityBanner" hidden role="status" aria-live="polite"></div>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <nav class="home-mobile-bottom-nav" aria-label="Main mobile navigation">
                <a class="home-mobile-nav-item @(isHomeDashboard ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.8 12 3l9 7.8v9.2a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                    <span data-i18n="dashboard">Home</span>
                </a>
                <a class="home-mobile-nav-item @(isInventoryPage ? "is-active" : "")" asp-controller="Inventory" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h5"/><path d="M13 16h3"/></svg>
                    <span data-i18n="inventory">Inventory</span>
                </a>
                <a class="home-mobile-nav-item home-mobile-nav-fab @(isBillingCreatePage ? "is-active" : "")" asp-controller="Billing" asp-action="Create">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <span data-i18n="bills">Bill</span>
                </a>
                <a class="home-mobile-nav-item @(isCustomerSectionPage ? "is-active" : "")" asp-controller="Customers" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                    <span data-i18n="customerManagement">Customers</span>
                </a>
                <a class="home-mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "is-active" : "")" asp-controller="Profile" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>
                    <span data-i18n="more">More</span>
                </a>
            </nav>
            <footer class="app-footer">
                <span>&copy; 2026 - @businessName</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" data-i18n="privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/language.js" asp-append-version="true"></script>
    <script src="~/js/offline-store.js" asp-append-version="true"></script>
    <script src="~/js/offline.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
@if (isAuthenticated)
{
    @Html.AntiForgeryToken()
    <script>
        (() => {
            // Record a real app open/resume without sending a database write on every page request.
            // localStorage survives normal app restarts, so the server is touched at most once per 4 hours.
            const activityKey = 'pharmaflow-last-app-open';
            const activityIntervalMs = 4 * 60 * 60 * 1000;
            const now = Date.now();
            const lastRecorded = Number(localStorage.getItem(activityKey) || '0');

            const touchSession = async () => {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) return;

                try {
                    const response = await fetch('@Url.Action("TouchSession", "Account")', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        localStorage.setItem(activityKey, String(Date.now()));
                    } else if (response.status === 401) {
                        window.location.replace('@Url.Action("Login", "Account")');
                    }
                } catch {
                    // Offline: do not clear the local session or interrupt the app.
                    // The next successful app open will record activity.
                }
            };

            if (!Number.isFinite(lastRecorded) || now - lastRecorded >= activityIntervalMs) {
                touchSession();
            }

            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState !== 'visible') return;

                const last = Number(localStorage.getItem(activityKey) || '0');
                if (!Number.isFinite(last) || Date.now() - last >= activityIntervalMs) {
                    touchSession();
                }
            });
        })();
    </script>
}
    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const toggle = document.getElementById('sidebarToggle');
            const close = document.getElementById('sidebarClose');
            const setOpen = (open) => {
                sidebar?.classList.toggle('is-open', open);
                overlay?.classList.toggle('is-visible', open);
                document.body.classList.toggle('sidebar-open', open);
            };
            toggle?.addEventListener('click', () => setOpen(true));
            close?.addEventListener('click', () => setOpen(false));
            overlay?.addEventListener('click', () => setOpen(false));
        })();
    </script>
    <script>
        (() => {
            const dropdowns = document.querySelectorAll('.sidebar-dropdown-toggle');

            dropdowns.forEach(trigger => {
                const menu = document.getElementById(trigger.getAttribute('aria-controls'));
                trigger.addEventListener('click', () => {
                    const willOpen = trigger.getAttribute('aria-expanded') !== 'true';

                    dropdowns.forEach(other => {
                        const otherMenu = document.getElementById(other.getAttribute('aria-controls'));
                        if (other !== trigger) {
                            other.setAttribute('aria-expanded', 'false');
                            otherMenu?.setAttribute('hidden', '');
                        }
                    });

                    trigger.setAttribute('aria-expanded', String(willOpen));
                    if (willOpen) menu?.removeAttribute('hidden');
                    else menu?.setAttribute('hidden', '');
                });
            });
        })();
    </script>
    <script>
        (() => {
            const trigger = document.getElementById('profileTrigger');
            const menu = document.getElementById('profileMenu');
            const appearanceToggle = document.getElementById('appearanceToggle');
            const appearancePanel = document.getElementById('appearancePanel');
            const languageToggle = document.getElementById('languageToggle');
            const languagePanel = document.getElementById('languagePanel');

            const applyTheme = (theme) => {
                const root = document.body;
                root.classList.remove('theme-dark');
                if (theme === 'dark') root.classList.add('theme-dark');
                if (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
                    root.classList.add('theme-dark');

                localStorage.setItem('pharmaflow-theme', theme);
                document.querySelectorAll('[data-theme-choice]').forEach(button => {
                    button.classList.toggle('is-selected', button.dataset.themeChoice === theme);
                });
            };

            const togglePanel = (panel, otherPanel) => {
                const open = panel?.hasAttribute('hidden');
                if (open) {
                    panel?.removeAttribute('hidden');
                    otherPanel?.setAttribute('hidden', '');
                } else {
                    panel?.setAttribute('hidden', '');
                }
            };

            applyTheme(localStorage.getItem('pharmaflow-theme') || 'light');

            trigger?.addEventListener('click', (event) => {
                event.stopPropagation();
                const open = menu?.hasAttribute('hidden');
                if (open) menu?.removeAttribute('hidden');
                else menu?.setAttribute('hidden', '');
                trigger.setAttribute('aria-expanded', String(open));
            });

            appearanceToggle?.addEventListener('click', (event) => {
                event.stopPropagation();
                togglePanel(appearancePanel, languagePanel);
                appearanceToggle.setAttribute('aria-expanded', String(!appearancePanel?.hasAttribute('hidden')));
                languageToggle?.setAttribute('aria-expanded', 'false');
            });

            languageToggle?.addEventListener('click', (event) => {
                event.stopPropagation();
                togglePanel(languagePanel, appearancePanel);
                languageToggle.setAttribute('aria-expanded', String(!languagePanel?.hasAttribute('hidden')));
                appearanceToggle?.setAttribute('aria-expanded', 'false');
            });

            document.querySelectorAll('[data-theme-choice]').forEach(button => {
                button.addEventListener('click', () => applyTheme(button.dataset.themeChoice));
            });

            document.querySelectorAll('[data-language-choice]').forEach(button => {
                button.addEventListener('click', () => {
                    const language = button.dataset.languageChoice;
                    localStorage.setItem('pharmaflow-language', language);
                    window.pharmaFlowLanguage?.apply(language);
                });
            });

            document.addEventListener('click', (event) => {
                if (!event.target.closest('.profile-menu')) {
                    menu?.setAttribute('hidden', '');
                    trigger?.setAttribute('aria-expanded', 'false');
                    appearancePanel?.setAttribute('hidden', '');
                    languagePanel?.setAttribute('hidden', '');
                    appearanceToggle?.setAttribute('aria-expanded', 'false');
                    languageToggle?.setAttribute('aria-expanded', 'false');
                }
            });

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
                if ((localStorage.getItem('pharmaflow-theme') || 'system') === 'system')
                    applyTheme('system');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
