@model PharmaFlow.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var businessName = Context.Session.GetString("BusinessName") ?? "PharmaFlow";
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <span class="dashboard-eyebrow">Welcome back</span>
            <h1 class="dashboard-title">@businessName Dashboard</h1>
            <p class="dashboard-subtitle">Monitor your pharmacy activity and the value PharmaFlow creates for your business.</p>
        </div>
        <div class="dashboard-date">@DateTime.Now.ToString("dd MMM yyyy")</div>
    </div>

    @if (Model.HasPharmaFlowValue)
    {
        <section class="dashboard-value-card" aria-label="PharmaFlow business value">
            <div class="value-card-main">
                <div>
                    <span class="section-kicker value-kicker">Your PharmaFlow value</span>
                    <h2>See how much money PharmaFlow protects for your pharmacy</h2>
                    <p class="value-description">
                        As your sales, purchases, inventory and payment data grows, PharmaFlow will calculate the
                        estimated money saved or protected through better stock control, expiry prevention and payment follow-up.
                    </p>
                </div>
                <div class="value-total">
                    <span class="value-total-label">Estimated money saved</span>
                    <strong>₹ @Model.EstimatedMoneySaved.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                    <small>Calculated from your actual business data.</small>
                </div>
            </div>

            <div class="value-proof-grid">
                <div class="value-proof">
                    <span class="value-proof-icon">⌛</span>
                    <div>
                        <strong>Expiry loss prevented</strong>
                        <span>Potential loss avoided from better expiry tracking</span>
                    </div>
                    <b>₹ @Model.ExpiryLossPrevented.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</b>
                </div>
                <div class="value-proof">
                    <span class="value-proof-icon">↗</span>
                    <div>
                        <strong>Cash recovered</strong>
                        <span>Outstanding customer payments followed up faster</span>
                    </div>
                    <b>₹ @Model.CashRecovered.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</b>
                </div>
                <div class="value-proof">
                    <span class="value-proof-icon">▤</span>
                    <div>
                        <strong>Inventory loss reduced</strong>
                        <span>Better stock visibility helps reduce avoidable holding losses</span>
                    </div>
                    <b>₹ @Model.InventoryLossReduced.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</b>
                </div>
            </div>

            <div class="value-card-footer">
                <span>PharmaFlow should show business impact, not just business data.</span>
                <span>Calculated from your real records</span>
            </div>
        </section>
    }

    <section class="dashboard-grid" aria-label="Pharmacy overview">
        <article class="dashboard-card metric-card metric-warning">
            <div class="metric-icon">⌛</div>
            <div><span class="metric-label">Products expiring soon</span><strong class="metric-value">—</strong><span class="metric-note">Review upcoming expiries</span></div>
        </article>
        <article class="dashboard-card metric-card metric-info">
            <div class="metric-icon">▤</div>
            <div><span class="metric-label">Low stock details</span><strong class="metric-value">—</strong><span class="metric-note">Items below reorder level</span></div>
        </article>
        <article class="dashboard-card metric-card metric-danger">
            <div class="metric-icon">!</div>
            <div><span class="metric-label">Out-of-stock items</span><strong class="metric-value">—</strong><span class="metric-note">Products needing replenishment</span></div>
        </article>
        <article class="dashboard-card metric-card metric-expired">
            <div class="metric-icon">⟳</div>
            <div><span class="metric-label">Products already expired</span><strong class="metric-value">—</strong><span class="metric-note">Check and quarantine stock</span></div>
        </article>
        <article class="dashboard-card metric-card metric-success">
            <div class="metric-icon">₹</div>
            <div><span class="metric-label">Today's sales</span><strong class="metric-value">₹ —</strong><span class="metric-note">Total sales for today</span></div>
        </article>
        <article class="dashboard-card metric-card metric-purple">
            <div class="metric-icon">⇄</div>
            <div><span class="metric-label">Customer debit / credit</span><strong class="metric-value">₹ —</strong><span class="metric-note">Pending customer balances</span></div>
        </article>
    </section>

    <section class="dashboard-section-grid">
        <article class="dashboard-card detail-card">
            <div class="card-heading"><div><span class="section-kicker">Payables</span><h2>Supplier pending payments</h2></div><span class="heading-icon">▣</span></div>
            <div class="empty-state"><span>₹</span><p>No supplier payment data available yet.</p></div>
        </article>
        <article class="dashboard-card detail-card">
            <div class="card-heading"><div><span class="section-kicker">Inventory trends</span><h2>Fast-moving products</h2></div><span class="heading-icon">↗</span></div>
            <div class="empty-state"><span>↗</span><p>Fast-moving product insights will appear here.</p></div>
        </article>
        <article class="dashboard-card detail-card">
            <div class="card-heading"><div><span class="section-kicker">Inventory trends</span><h2>Slow-moving products</h2></div><span class="heading-icon">↘</span></div>
            <div class="empty-state"><span>↘</span><p>Slow-moving product insights will appear here.</p></div>
        </article>
    </section>

    <section class="dashboard-card activity-card">
        <div class="card-heading"><div><span class="section-kicker">Activity</span><h2>Recent sales and payments</h2></div><span class="heading-icon">☷</span></div>
        <div class="table-responsive">
            <table class="table dashboard-table align-middle mb-0">
                <thead><tr><th>Activity</th><th>Reference</th><th>Date</th><th class="text-end">Amount</th></tr></thead>
                <tbody><tr><td colspan="4" class="empty-table">No recent activity available yet.</td></tr></tbody>
            </table>
        </div>
    </section>
</div>
