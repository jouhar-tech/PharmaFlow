@model PharmaFlow.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var businessName = Context.Session.GetString("BusinessName") ?? "PharmaHex";
    var indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
    var indiaNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, indiaTimeZone);
    var greeting = indiaNow.Hour < 12
        ? "Good Morning,"
        : indiaNow.Hour < 17
            ? "Good Afternoon,"
            : indiaNow.Hour < 21
                ? "Good Evening,"
                : "Good Night,";
    var displayName = !string.IsNullOrWhiteSpace(Model.ProfileFullName)
        ? Model.ProfileFullName
        : Context.Session.GetString("Username") ?? businessName;
    var avatarInitial = !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Trim()[0].ToString().ToUpperInvariant()
        : "U";
}

@await Html.PartialAsync("_InvoiceCapture")

<div class="home-mobile-dashboard">
    <header class="home-mobile-hero">
        <div class="home-mobile-topline">
            <div class="home-mobile-greeting">
                <a asp-controller="Profile" asp-action="Account"
                   class="home-mobile-avatar-link"
                   aria-label="Open your profile"
                   title="Open your profile">
                    <span class="home-mobile-avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoUrl))
                        {
                            <img src="@Model.ProfilePhotoUrl" alt="" />
                        }
                        else
                        {
                            @avatarInitial
                        }
                    </span>
                </a>
                <div class="home-mobile-greeting-copy">
                    <span class="home-mobile-greeting-label">@greeting</span>
                    <strong>@displayName</strong>
                </div>
            </div>
            <a asp-controller="Notifications" asp-action="Index"
               class="home-mobile-notification"
               data-notification-button
               aria-label="Open notifications"
               title="Open notifications">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
                <span></span>
            </a>
        </div>

        <div class="home-mobile-business">
            <h1>@businessName</h1>
            <p>@indiaNow.ToString("dd MMM yyyy")</p>
        </div>
    </header>

    <main class="home-mobile-content">
        <a asp-controller="Bills" asp-action="Index" asp-route-period="Last 7 Days"
           class="home-mobile-sales-card home-mobile-sales-card-link"
           aria-label="View bills from the last 7 days">
            <div class="home-mobile-sales-head">
                <div>
                    <span class="home-mobile-eyebrow">Today&rsquo;s Sales</span>
                    <strong class="home-mobile-sales-total">₹@Model.TodaySalesAmount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                    @if (Model.TodaySalesAmount <= 0)
                    {
                        <span class="home-mobile-sales-empty-message"><span data-i18n="noSalesToday">No sales recorded today yet.</span></span>
                    }
                </div>
                <span class="home-mobile-sales-pill">Today</span>
            </div>
        </a>

        @if (Model.ProductsExpiringSoonCount > 0 || Model.LowStockCount > 0 || Model.CustomerOutstandingAmount > 0m || Model.SlowMovingStockCount > 0 || Model.RemindersDueCount > 0)
        {
            <section class="home-mobile-attention-section" aria-labelledby="homeAttentionHeading">
                <h2 id="homeAttentionHeading" data-i18n="whatNeedsAttention">What needs your attention</h2>

                @if (Model.ProductsExpiringSoonCount > 0)
                {
                    <a asp-controller="ExpiryProducts" asp-action="Index" class="home-mobile-attention-row home-mobile-attention-expiry">
                        <span class="home-mobile-attention-icon" aria-hidden="true">!</span>
                        <span class="home-mobile-attention-copy">
                            <strong>@Model.ProductsExpiringSoonCount <span data-i18n="expiring">Expiring</span></strong>
                            <small>₹@Model.ExpiryAtRiskValue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="atRisk">at risk</span></small>
                        </span>
                        <span class="home-mobile-attention-view" data-i18n="view">View</span>
                        <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
                    </a>
                }

                @if (Model.LowStockCount > 0)
                {
                    <a asp-controller="LowStock" asp-action="Index" class="home-mobile-attention-row home-mobile-attention-low-stock">
                        <span class="home-mobile-attention-icon" aria-hidden="true">!</span>
                        <span class="home-mobile-attention-copy">
                            <strong>@Model.LowStockCount <span data-i18n="lowStock">Low Stock</span></strong>
                        </span>
                        <span class="home-mobile-attention-view" data-i18n="view">View</span>
                        <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
                    </a>
                }

                @if (Model.CustomerOutstandingAmount > 0m)
                {
                    <a asp-controller="Customers" asp-action="Index" class="home-mobile-attention-row home-mobile-attention-money">
                        <span class="home-mobile-attention-icon" aria-hidden="true">₹</span>
                        <span class="home-mobile-attention-copy">
                            <strong>₹@Model.CustomerOutstandingAmount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="udhaar">Udhaar</span></strong>
                            <small>@Model.CustomersWithOutstanding <span data-i18n="customers">customers</span></small>
                        </span>
                        <span class="home-mobile-attention-view" data-i18n="view">View</span>
                        <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
                    </a>
                }

                @if (Model.SlowMovingStockCount > 0)
                {
                    <a asp-controller="SlowMoving" asp-action="Index" class="home-mobile-attention-row home-mobile-attention-slow">
                        <span class="home-mobile-attention-icon" aria-hidden="true">↘</span>
                        <span class="home-mobile-attention-copy">
                            <strong>₹@Model.SlowMovingStockValue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="slowMoving">Slow Moving</span></strong>
                        </span>
                        <span class="home-mobile-attention-view" data-i18n="view">View</span>
                        <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
                    </a>
                }

                @if (Model.RemindersDueCount > 0)
                {
                    <a asp-controller="Customers" asp-action="Index" class="home-mobile-attention-row home-mobile-attention-reminder">
                        <span class="home-mobile-attention-icon" aria-hidden="true">✓</span>
                        <span class="home-mobile-attention-copy">
                            <strong>@Model.RemindersDueCount <span data-i18n="remindersDue">Reminders Due</span></strong>
                        </span>
                        <span class="home-mobile-attention-view" data-i18n="view">View</span>
                        <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
                    </a>
                }
            </section>
        }

        <section class="home-mobile-quick-actions" aria-labelledby="homeQuickActionsHeading">
            <h2 id="homeQuickActionsHeading" data-i18n="quickActions">Quick Actions</h2>
            <div class="home-mobile-quick-actions-grid">
                <label class="home-mobile-quick-action" for="dashboardUploadInput">
                    <span class="home-mobile-action-icon">
                        <svg viewBox="0 0 64 64"><rect x="12" y="11" width="33" height="39" rx="4"/><rect x="20" y="19" width="33" height="39" rx="4"/><path d="M28 28h16M28 35h13M37 48v-9M33 43l4-4 4 4"/></svg>
                    </span>
                    <strong data-i18n="addStock">Add Stock</strong>
                </label>

                <a class="home-mobile-quick-action" asp-controller="Billing" asp-action="Create">
                    <span class="home-mobile-action-icon">
                        <svg viewBox="0 0 64 64"><path d="M17 9h28v46H17z"/><path d="M22 18h18M22 26h18M22 34h12"/><path d="M45 16v31l9-8V9z"/><path d="M49 39v10M45 45h8"/></svg>
                    </span>
                    <strong data-i18n="createBill">Create Bill</strong>
                </a>
            </div>
        </section>

        <button type="button"
                class="home-mobile-scan-invoice-button"
                id="dashboardMobileScanInvoiceTrigger"
                aria-label="Scan multiple supplier invoices">
            <span class="home-mobile-scan-invoice-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7V5a1 1 0 0 1 1-1h2M17 4h2a1 1 0 0 1 1 1v2M20 17v2a1 1 0 0 1-1 1h-2M7 20H5a1 1 0 0 1-1-1v-2"/>
                    <path d="M8 12h8M12 8v8"/>
                </svg>
            </span>
            <span class="home-mobile-scan-invoice-copy">
                <strong data-i18n="scanInvoice">Scan Invoice</strong>
                <small>Scan multiple supplier invoices with your camera</small>
            </span>
            <span class="home-mobile-scan-invoice-chevron" aria-hidden="true">›</span>
        </button>

        @if (Model.HasPharmaFlowValue)
        {
            <section class="home-mobile-value-card" aria-label="PharmaHex business value">
                <span>Your PharmaHex value</span>
                <strong>₹ @Model.EstimatedMoneySaved.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                <small>Estimated money saved or protected from better stock control.</small>
            </section>
        }

        <div class="home-mobile-selected" id="stockCaptureSelected" hidden role="status" aria-live="polite">
            <span class="home-mobile-selected-icon">✓</span>
            <div>
                <strong>Invoice selected</strong>
                <span id="stockCaptureSelectedName"></span>
            </div>
            <button type="button" id="stockCaptureReset" class="home-mobile-selected-reset">Choose another</button>
        </div>

        
    </main>
</div>

<div class="home-desktop-dashboard">
    <div class="home-desktop-container">
        <header class="home-desktop-header">
            <div>
                <span class="home-desktop-eyebrow" data-i18n="welcomeBack">Welcome back</span>
                <h1>@businessName</h1>
                <p>Your pharmacy at a glance. Review today's activity and anything that needs attention.</p>
            </div>
            <div class="home-desktop-date">@indiaNow.ToString("dd MMM yyyy")</div>
        </header>

        <a asp-controller="Bills" asp-action="Index" asp-route-period="Last 7 Days"
           class="home-desktop-sales-card"
           aria-label="View bills from the last 7 days">
            <div>
                <span class="home-desktop-section-kicker" data-i18n="todaysSales">Today's sales</span>
                <strong>₹@Model.TodaySalesAmount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                @if (Model.TodaySalesAmount <= 0)
                {
                    <small data-i18n="noSalesToday">No sales recorded today yet.</small>
                }
                else
                {
                    <small>Total sales recorded today</small>
                }
            </div>
            <span class="home-desktop-sales-pill">Today <span aria-hidden="true">↗</span></span>
        </a>

        @if (Model.ProductsExpiringSoonCount > 0 || Model.LowStockCount > 0 || Model.CustomerOutstandingAmount > 0m || Model.SlowMovingStockCount > 0 || Model.RemindersDueCount > 0)
        {
            <section class="home-desktop-section" aria-labelledby="homeDesktopAttentionHeading">
                <div class="home-desktop-section-heading">
                    <div>
                        <span class="home-desktop-section-kicker">Business overview</span>
                        <h2 id="homeDesktopAttentionHeading" data-i18n="whatNeedsAttention">What needs your attention</h2>
                    </div>
                    <span class="home-desktop-section-note">Important items from your pharmacy</span>
                </div>

                <div class="home-desktop-attention-grid">
                    @if (Model.ProductsExpiringSoonCount > 0)
                    {
                        <a asp-controller="ExpiryProducts" asp-action="Index" class="home-desktop-attention-row home-desktop-attention-expiry">
                            <span class="home-desktop-attention-icon" aria-hidden="true">!</span>
                            <span class="home-desktop-attention-copy">
                                <strong>@Model.ProductsExpiringSoonCount <span data-i18n="expiring">Expiring</span></strong>
                                <small>₹@Model.ExpiryAtRiskValue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="atRisk">at risk</span></small>
                            </span>
                            <span class="home-desktop-attention-view" data-i18n="view">View</span>
                            <span class="home-desktop-attention-chevron" aria-hidden="true">›</span>
                        </a>
                    }

                    @if (Model.LowStockCount > 0)
                    {
                        <a asp-controller="LowStock" asp-action="Index" class="home-desktop-attention-row home-desktop-attention-low-stock">
                            <span class="home-desktop-attention-icon" aria-hidden="true">!</span>
                            <span class="home-desktop-attention-copy">
                                <strong>@Model.LowStockCount <span data-i18n="lowStock">Low Stock</span></strong>
                                <small>Items below your reorder level</small>
                            </span>
                            <span class="home-desktop-attention-view" data-i18n="view">View</span>
                            <span class="home-desktop-attention-chevron" aria-hidden="true">›</span>
                        </a>
                    }

                    @if (Model.CustomerOutstandingAmount > 0m)
                    {
                        <a asp-controller="Customers" asp-action="Index" class="home-desktop-attention-row home-desktop-attention-money">
                            <span class="home-desktop-attention-icon" aria-hidden="true">₹</span>
                            <span class="home-desktop-attention-copy">
                                <strong>₹@Model.CustomerOutstandingAmount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="udhaar">Udhaar</span></strong>
                                <small>@Model.CustomersWithOutstanding <span data-i18n="customers">customers</span></small>
                            </span>
                            <span class="home-desktop-attention-view" data-i18n="view">View</span>
                            <span class="home-desktop-attention-chevron" aria-hidden="true">›</span>
                        </a>
                    }

                    @if (Model.SlowMovingStockCount > 0)
                    {
                        <a asp-controller="SlowMoving" asp-action="Index" class="home-desktop-attention-row home-desktop-attention-slow">
                            <span class="home-desktop-attention-icon" aria-hidden="true">↘</span>
                            <span class="home-desktop-attention-copy">
                                <strong>₹@Model.SlowMovingStockValue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) <span data-i18n="slowMoving">Slow Moving</span></strong>
                                <small>@Model.SlowMovingStockCount slow-moving products</small>
                            </span>
                            <span class="home-desktop-attention-view" data-i18n="view">View</span>
                            <span class="home-desktop-attention-chevron" aria-hidden="true">›</span>
                        </a>
                    }

                    @if (Model.RemindersDueCount > 0)
                    {
                        <a asp-controller="Customers" asp-action="Index" class="home-desktop-attention-row home-desktop-attention-reminder">
                            <span class="home-desktop-attention-icon" aria-hidden="true">✓</span>
                            <span class="home-desktop-attention-copy">
                                <strong>@Model.RemindersDueCount <span data-i18n="remindersDue">Reminders Due</span></strong>
                                <small>Customer follow-ups to review</small>
                            </span>
                            <span class="home-desktop-attention-view" data-i18n="view">View</span>
                            <span class="home-desktop-attention-chevron" aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="home-desktop-section home-desktop-quick-actions" aria-labelledby="homeDesktopQuickActionsHeading">
            <div class="home-desktop-section-heading">
                <div>
                    <span class="home-desktop-section-kicker" data-i18n="quickActions">Quick Actions</span>
                    <h2 id="homeDesktopQuickActionsHeading">Get work done</h2>
                </div>
            </div>

            <div class="home-desktop-action-grid">
                <label class="home-desktop-action home-desktop-action-stock" for="dashboardUploadInput">
                    <span class="home-desktop-action-icon" aria-hidden="true">＋</span>
                    <span>
                        <strong data-i18n="addStock">Add Stock</strong>
                        <small>Upload a supplier invoice</small>
                    </span>
                    <span class="home-desktop-action-arrow" aria-hidden="true">›</span>
                </label>

                <a class="home-desktop-action home-desktop-action-bill" asp-controller="Billing" asp-action="Create">
                    <span class="home-desktop-action-icon" aria-hidden="true">₹</span>
                    <span>
                        <strong data-i18n="createBill">Create Bill</strong>
                        <small>Create a customer bill</small>
                    </span>
                    <span class="home-desktop-action-arrow" aria-hidden="true">›</span>
                </a>

                <button type="button" class="home-desktop-action home-desktop-action-scan" id="dashboardDesktopScanInvoiceTrigger">
                    <span class="home-desktop-action-icon" aria-hidden="true">⌗</span>
                    <span>
                        <strong data-i18n="scanInvoice">Scan Invoice</strong>
                        <small>Capture with your camera</small>
                    </span>
                    <span class="home-desktop-action-arrow" aria-hidden="true">›</span>
                </button>
            </div>
        </section>

        @if (Model.HasPharmaFlowValue)
        {
            <section class="home-desktop-value-card" aria-label="PharmaHex business value">
                <div class="home-desktop-value-icon" aria-hidden="true">✦</div>
                <div>
                    <span class="home-desktop-section-kicker">Your PharmaHex value</span>
                    <h2>Money saved or protected</h2>
                    <p>Estimated value created through better stock control, expiry prevention and payment follow-up.</p>
                </div>
                <strong>₹@Model.EstimatedMoneySaved.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
            </section>
        }
    </div>
</div>


@section Scripts {
    <script src="~/js/invoice-capture.js" asp-append-version="true"></script>
}
