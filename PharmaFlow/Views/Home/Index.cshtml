@model PharmaFlow.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var businessName = Context.Session.GetString("BusinessName") ?? "PharmaFlow";
}

<div class="home-invoice-inputs" aria-hidden="true">
    <input id="dashboardCameraInput"
           class="dashboard-file-input"
           type="file"
           accept="image/*"
           tabindex="-1" />
    <input id="dashboardUploadInput"
           class="dashboard-file-input"
           type="file"
           accept="image/*,application/pdf,.pdf"
           tabindex="-1" />
    <div id="invoiceCaptureAntiForgeryToken" hidden>
        @Html.AntiForgeryToken()
    </div>
</div>


<div class="home-mobile-dashboard">
    <header class="home-mobile-hero">
        <div class="home-mobile-topline">
            <div class="home-mobile-greeting">
                <span class="home-mobile-avatar">@((Context.Session.GetString("Username") ?? businessName).FirstOrDefault().ToString().ToUpperInvariant())</span>
                <div>
                    <span class="home-mobile-greeting-label">Greetings,</span>
                    <strong>@(Context.Session.GetString("Username") ?? businessName)</strong>
                </div>
            </div>
            <button type="button" class="home-mobile-notification" aria-label="Notifications">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
                <span></span>
            </button>
        </div>

        <div class="home-mobile-business">
            <h1>@businessName</h1>
            <p>@DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
    </header>

    <main class="home-mobile-content">
        <section class="home-mobile-sales-card" aria-label="Today's sales">
            <div class="home-mobile-sales-head">
                <div>
                    <span class="home-mobile-eyebrow">Today&rsquo;s Sales</span>
                    <strong class="home-mobile-sales-total">₹0</strong>
                    <span class="home-mobile-sales-empty-message"><span data-i18n="noSalesToday">No sales recorded today yet.</span></span>
                </div>
                <span class="home-mobile-sales-pill">Today</span>
            </div>
            <svg class="home-mobile-sales-chart" viewBox="0 0 520 110" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                    <linearGradient id="homeSalesFill" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0" stop-color="#54a9a6" stop-opacity=".28" />
                        <stop offset="1" stop-color="#54a9a6" stop-opacity="0" />
                    </linearGradient>
                </defs>
                <path d="M8 89 C54 72, 65 60, 105 70 S155 88, 194 66 S248 42, 286 58 S336 89, 373 58 S426 30, 463 47 S493 59, 512 25 L512 110 L8 110 Z" fill="url(#homeSalesFill)" />
                <path d="M8 89 C54 72, 65 60, 105 70 S155 88, 194 66 S248 42, 286 58 S336 89, 373 58 S426 30, 463 47 S493 59, 512 25" fill="none" stroke="#54a9a6" stroke-width="5" stroke-linecap="round" />
            </svg>
            
        </section>

        <label class="home-mobile-scan-card" for="dashboardCameraInput">
            <span class="home-mobile-action-icon home-mobile-scan-icon" aria-hidden="true">
                <svg viewBox="0 0 64 64"><rect x="9" y="18" width="38" height="31" rx="5"/><path d="M18 18l5-7h12l5 7M47 25h4a4 4 0 0 1 4 4v18a4 4 0 0 1-4 4H47"/><circle cx="28" cy="33" r="8"/><path d="M42 38h12M42 44h10"/></svg>
            </span>
            <span class="home-mobile-scan-copy">
                <strong>Scan / Upload Invoice</strong>
                <small>Capture an invoice and add stock faster</small>
            </span>
            <span class="home-mobile-card-chevron" aria-hidden="true">›</span>
        </label>


        <div class="home-mobile-action-grid">
            <label class="home-mobile-action-card" for="dashboardUploadInput">
                <span class="home-mobile-action-icon">
                    <svg viewBox="0 0 64 64"><rect x="12" y="11" width="33" height="39" rx="4"/><rect x="20" y="19" width="33" height="39" rx="4"/><path d="M28 28h16M28 35h13M37 48v-9M33 43l4-4 4 4"/></svg>
                </span>
                <strong>Add Stock</strong>
            </label>

            <button type="button" class="home-mobile-action-card" aria-disabled="true">
                <span class="home-mobile-action-icon">
                    <svg viewBox="0 0 64 64"><path d="M17 9h28v46H17z"/><path d="M22 18h18M22 26h18M22 34h12"/><path d="M45 16v31l9-8V9z"/><path d="M49 39v10M45 45h8"/></svg>
                </span>
                <strong>Create Bill</strong>
            </button>

            <a class="home-mobile-action-card home-mobile-count-card" asp-controller="ExpiryProducts" asp-action="Index">
                <span class="home-mobile-count-badge home-mobile-expiry-count-badge" aria-label="@Model.ProductsExpiringSoonCount products expiring soon">@Model.ProductsExpiringSoonCount</span>
                <span class="home-mobile-action-icon">
                    <svg viewBox="0 0 64 64"><rect x="11" y="15" width="42" height="39" rx="5"/><path d="M21 10v10M43 10v10M11 26h42"/><path d="M24 36h4M36 36h4M24 45h4"/><circle cx="45" cy="47" r="8"/><path d="M45 43v5M45 51h.01"/></svg>
                </span>
                <strong>Expiry Details</strong>
                <span class="home-mobile-expiry-risk-value">At-risk ₹ @Model.ExpiryAtRiskValue.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</span>
            </a>

            <a class="home-mobile-action-card home-mobile-count-card" asp-controller="LowStock" asp-action="Index">
                <span class="home-mobile-count-badge home-mobile-low-stock-count-badge" aria-label="@Model.LowStockCount low stock products">@Model.LowStockCount</span>
                <span class="home-mobile-action-icon">
                    <svg viewBox="0 0 64 64"><path d="M10 48V22h17M10 48h44M18 40l9-10 8 6 15-18"/><path d="M42 14h10v10"/><path d="M44 43h10M44 49h7"/></svg>
                </span>
                <strong>Low Stock Details</strong>
            </a>
        </div>

        @if (Model.HasPharmaFlowValue)
        {
            <section class="home-mobile-value-card" aria-label="PharmaFlow business value">
                <span>Your PharmaFlow value</span>
                <strong>₹ @Model.EstimatedMoneySaved.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                <small>Estimated money saved or protected from better stock control.</small>
            </section>
        }

        <div class="home-mobile-selected" id="stockCaptureSelected" hidden role="status" aria-live="polite">
            <span class="home-mobile-selected-icon">✓</span>
            <div>
                <strong>Invoice selected</strong>
                <span id="stockCaptureSelectedName"></span>
            </div>
            <button type="button" id="stockCaptureReset" class="home-mobile-selected-reset">Choose another</button>
        </div>

        
    </main>
</div>

<div class="home-desktop-dashboard">
    <div class="dashboard-page">
        <div class="dashboard-header">
            <div>
                <span class="dashboard-eyebrow" data-i18n="welcomeBack">Welcome back</span>
                <h1 class="dashboard-title">@businessName <span data-i18n="dashboard">Dashboard</span></h1>
                <p class="dashboard-subtitle"> <span data-i18n="dashboardSubtitle">Monitor your pharmacy activity and the value PharmaFlow creates for your business.</span></p>
            </div>
            <div class="dashboard-date">@DateTime.Now.ToString("dd MMM yyyy")</div>
        </div>

        <section id="add-stock" class="dashboard-stock-actions" aria-label="Add stock">
            <div class="dashboard-stock-actions-copy">
                <span class="section-kicker" data-i18n="addStock">Add stock</span>
                <h2 data-i18n="stockCaptureHeading">Capture an invoice in seconds</h2>
                <p data-i18n="stockCaptureDescription">Scan a printed pharmacy invoice with your camera or upload a document from your device.</p>
            </div>

            <div class="dashboard-stock-actions-buttons">
                <label class="stock-capture-button stock-capture-primary" for="dashboardCameraInput">
                    <span class="stock-capture-icon">⌁</span>
                    <span>
                        <strong data-i18n="scanInvoice">Scan Invoice</strong>
                        <small data-i18n="scanInvoiceHint">Use camera</small>
                    </span>
                </label>

                <label class="stock-capture-button stock-capture-secondary" for="dashboardUploadInput">
                    <span class="stock-capture-icon">↑</span>
                    <span>
                        <strong data-i18n="uploadInvoice">Upload Invoice</strong>
                        <small data-i18n="uploadInvoiceHint">From device</small>
                    </span>
                </label>
            </div>
        </section>

        @if (Model.HasPharmaFlowValue)
        {
            <section class="dashboard-value-card" aria-label="PharmaFlow business value">
                <div class="value-card-main">
                    <div>
                        <span class="section-kicker value-kicker" data-i18n="valueKicker">Your PharmaFlow value</span>
                        <h2 data-i18n="valueHeading">See how much money PharmaFlow protects for your pharmacy</h2>
                        <p class="value-description" data-i18n="valueDescription">As your sales, purchases, inventory and payment data grows, PharmaFlow will calculate the estimated money saved or protected through better stock control, expiry prevention and payment follow-up.</p>
                    </div>
                    <div class="value-total">
                        <span class="value-total-label" data-i18n="estimatedMoneySaved">Estimated money saved</span>
                        <strong>₹ @Model.EstimatedMoneySaved.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
                        <small data-i18n="calculatedFromActualData">Calculated from your actual business data.</small>
                    </div>
                </div>
            </section>
        }

        <section class="dashboard-grid" aria-label="Pharmacy overview">
            <a asp-controller="ExpiryProducts" asp-action="Index" class="dashboard-card metric-card metric-warning metric-card-link">
                <div class="metric-icon">⌛</div>
                <div><span class="metric-label" data-i18n="productsExpiringSoon">Products expiring soon</span><strong class="metric-value">@Model.ProductsExpiringSoonCount</strong><span class="metric-note" data-i18n="reviewUpcomingExpiries">Critical + upcoming stock</span><span class="metric-at-risk-value">At-risk ₹ @Model.ExpiryAtRiskValue.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</span></div>
            </a>
            <a asp-controller="LowStock" asp-action="Index" class="dashboard-card metric-card metric-info metric-card-link">
                <div class="metric-icon">▤</div>
                <div><span class="metric-label" data-i18n="lowStockDetailsMetric">Low stock details</span><strong class="metric-value">@Model.LowStockCount</strong><span class="metric-note" data-i18n="itemsBelowReorderLevel">Quantity below 3</span></div>
            </a>
            <article class="dashboard-card metric-card metric-danger">
                <div class="metric-icon">!</div>
                <div><span class="metric-label" data-i18n="outOfStockItems">Out-of-stock items</span><strong class="metric-value">—</strong><span class="metric-note" data-i18n="productsNeedingReplenishment">Products needing replenishment</span></div>
            </article>
            <article class="dashboard-card metric-card metric-expired">
                <div class="metric-icon">⟳</div>
                <div><span class="metric-label" data-i18n="productsAlreadyExpired">Products already expired</span><strong class="metric-value">—</strong><span class="metric-note" data-i18n="checkAndQuarantineStock">Check and quarantine stock</span></div>
            </article>
            <article class="dashboard-card metric-card metric-success">
                <div class="metric-icon">₹</div>
                <div><span class="metric-label" data-i18n="todaysSales">Today's sales</span><strong class="metric-value">₹ —</strong><span class="metric-note" data-i18n="totalSalesForToday">Total sales for today</span></div>
            </article>
            <article class="dashboard-card metric-card metric-purple">
                <div class="metric-icon">⇄</div>
                <div><span class="metric-label" data-i18n="customerDebitCredit">Customer debit / credit</span><strong class="metric-value">₹ —</strong><span class="metric-note" data-i18n="pendingCustomerBalances">Pending customer balances</span></div>
            </article>
        </section>

        <section class="dashboard-section-grid">
            <article class="dashboard-card detail-card">
                <div class="card-heading"><div><span class="section-kicker" data-i18n="payables">Payables</span><h2 data-i18n="supplierPendingPayments">Supplier pending payments</h2></div><span class="heading-icon">▣</span></div>
                <div class="empty-state"><span>₹</span><p data-i18n="noSupplierPaymentData">No supplier payment data available yet.</p></div>
            </article>
            <article class="dashboard-card detail-card">
                <div class="card-heading"><div><span class="section-kicker" data-i18n="inventoryTrends">Inventory trends</span><h2 data-i18n="fastMovingProducts">Fast-moving products</h2></div><span class="heading-icon">↗</span></div>
                <div class="empty-state"><span>↗</span><p data-i18n="fastMovingInsights">Fast-moving product insights will appear here.</p></div>
            </article>
            <article class="dashboard-card detail-card">
                <div class="card-heading"><div><span class="section-kicker" data-i18n="inventoryTrends">Inventory trends</span><h2 data-i18n="slowMovingProducts">Slow-moving products</h2></div><span class="heading-icon">↘</span></div>
                <div class="empty-state"><span>↘</span><p data-i18n="slowMovingInsights">Slow-moving product insights will appear here.</p></div>
            </article>
        </section>
    </div>
</div>

<div class="invoice-scanner-modal" id="invoiceScannerModal" hidden>
    <div class="invoice-scanner-backdrop" id="invoiceScannerBackdrop"></div>
    <section class="invoice-scanner-panel" role="dialog" aria-modal="true" aria-labelledby="invoiceScannerTitle">
        <header class="invoice-scanner-header">
            <div>
                <span class="section-kicker" data-i18n="stockCaptureHeading">Capture an invoice in seconds</span>
                <h2 id="invoiceScannerTitle" data-i18n="scanInvoicePreview">Review invoice scan</h2>
            </div>
            <button type="button" class="invoice-scanner-close" id="invoiceScannerClose" data-i18n-attr="aria-label:closeScanner">×</button>
        </header>

        <div class="invoice-scanner-stage">
            <div class="invoice-scanner-preview" id="invoiceScannerPreview">
                <img id="invoiceScannerImage" alt="Invoice preview" hidden />
                <div class="invoice-scanner-pdf" id="invoiceScannerPdf" hidden>
                    <span class="invoice-scanner-pdf-icon">PDF</span>
                    <strong id="invoiceScannerPdfName"></strong>
                    <span data-i18n="pdfReadyForProcessing">PDF selected and ready for processing.</span>
                </div>
                <span class="invoice-scanner-corner invoice-scanner-corner-tl"></span>
                <span class="invoice-scanner-corner invoice-scanner-corner-tr"></span>
                <span class="invoice-scanner-corner invoice-scanner-corner-bl"></span>
                <span class="invoice-scanner-corner invoice-scanner-corner-br"></span>
            </div>
        </div>

        <div class="invoice-scanner-controls">
            <button type="button" class="invoice-scanner-control" id="invoiceRotate" data-image-only>
                <span>↻</span>
                <small data-i18n="rotateInvoice">Rotate</small>
            </button>
            <button type="button" class="invoice-scanner-control" id="invoiceEnhance" data-image-only aria-pressed="false">
                <span>✦</span>
                <small data-i18n="enhanceForOcr">Enhance text</small>
            </button>
        </div>

        <p class="invoice-scanner-hint" data-i18n="scannerPreviewHint">Make sure the full invoice is visible and the text is sharp before continuing.</p>

        <div class="invoice-ocr-status" id="invoiceOcrStatus" hidden role="status" aria-live="polite">
            <div class="invoice-ocr-status-head">
                <strong id="invoiceOcrStatusTitle" data-i18n="ocrPreparing">Preparing invoice analysis...</strong>
                <span id="invoiceOcrProgress">0%</span>
            </div>
            <div class="invoice-ocr-progress"><span id="invoiceOcrProgressBar"></span></div>
            <small id="invoiceOcrStatusMessage" data-i18n="ocrStarting">Preparing AI invoice analysis.</small>
        </div>

        <footer class="invoice-scanner-footer">
            <button type="button" class="btn btn-outline-secondary" id="invoiceScannerRetake" data-i18n="retakeInvoice">Retake / Choose another</button>
            <button type="button" class="btn btn-primary" id="invoiceScannerUse" data-i18n="useThisScan">Use this scan</button>
        </footer>
    </section>
</div>
@section Scripts {
<script>
    (() => {
        const cameraInput = document.getElementById("dashboardCameraInput");
        const uploadInput = document.getElementById("dashboardUploadInput");
        const selected = document.getElementById("stockCaptureSelected");
        const selectedName = document.getElementById("stockCaptureSelectedName");
        const reset = document.getElementById("stockCaptureReset");

        const scanner = document.getElementById("invoiceScannerModal");
        const scannerPreview = document.getElementById("invoiceScannerPreview");
        const scannerImage = document.getElementById("invoiceScannerImage");
        const scannerPdf = document.getElementById("invoiceScannerPdf");
        const scannerPdfName = document.getElementById("invoiceScannerPdfName");
        const rotateButton = document.getElementById("invoiceRotate");
        const enhanceButton = document.getElementById("invoiceEnhance");
        const useButton = document.getElementById("invoiceScannerUse");
        const retakeButton = document.getElementById("invoiceScannerRetake");
        const closeButton = document.getElementById("invoiceScannerClose");
        const backdrop = document.getElementById("invoiceScannerBackdrop");

        const ocrStatus = document.getElementById("invoiceOcrStatus");
        const ocrStatusTitle = document.getElementById("invoiceOcrStatusTitle");
        const ocrStatusMessage = document.getElementById("invoiceOcrStatusMessage");
        const ocrProgress = document.getElementById("invoiceOcrProgress");
        const ocrProgressBar = document.getElementById("invoiceOcrProgressBar");

        let pendingFile = null;
        let pendingSourceType = "upload";
        let previewUrl = null;
        let rotation = 0;
        let enhanceText = false;

        const MAX_FILE_SIZE = 25 * 1024 * 1024;
        const MAX_PDF_PAGES = 20;

        const setBusy = (busy) => {
            [useButton, retakeButton, rotateButton, enhanceButton].forEach(button => {
                if (button) button.disabled = busy;
            });
        };

        const revokePreview = () => {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
        };

        const closeScanner = () => {
            scanner?.setAttribute("hidden", "");
            document.body.classList.remove("invoice-scanner-open");
            revokePreview();
        };

        const showFinalSelection = (file) => {
            if (!file || !selected || !selectedName) return;

            selectedName.textContent = file.name;
            selected.removeAttribute("hidden");

            document.querySelectorAll(".stock-capture-button").forEach(button => {
                button.classList.add("is-muted");
            });
        };

        const updateOcrStatus = (title, message, progress = 0) => {
            ocrStatus?.removeAttribute("hidden");
            if (ocrStatusTitle) ocrStatusTitle.textContent = title;
            if (ocrStatusMessage) ocrStatusMessage.textContent = message;
            const bounded = Math.max(0, Math.min(100, progress));
            if (ocrProgress) ocrProgress.textContent = Math.round(bounded) + "%";
            if (ocrProgressBar) ocrProgressBar.style.width = bounded + "%";
        };

        const resetOcrUi = () => {
            ocrStatus?.setAttribute("hidden", "");
            if (ocrProgressBar) ocrProgressBar.style.width = "0%";
        };

        const resetSelection = () => {
            if (cameraInput) cameraInput.value = "";
            if (uploadInput) uploadInput.value = "";
            selected?.setAttribute("hidden", "");
            pendingFile = null;
            pendingSourceType = "upload";
            window.pharmaFlowInvoiceCapture = null;
            resetOcrUi();
            closeScanner();

            document.querySelectorAll(".stock-capture-button").forEach(button => {
                button.classList.remove("is-muted");
            });
        };

        const fitScannerPreviewToImage = () => {
            if (!scannerImage || !scannerPreview || scannerImage.hidden) return;
            if (!scannerImage.naturalWidth || !scannerImage.naturalHeight) return;

            const stage = scannerPreview.closest(".invoice-scanner-stage");
            if (!stage) return;

            const availableWidth = Math.max(1, stage.clientWidth);
            const isMobile = window.matchMedia("(max-width: 575.98px)").matches;
            const availableHeight = Math.max(
                1,
                isMobile
                    ? window.innerHeight - 330
                    : Math.min(window.innerHeight * 0.62, 560)
            );
            const angle = ((rotation % 360) + 360) % 360;
            const rotated = angle === 90 || angle === 270;

            const imageWidth = rotated
                ? scannerImage.naturalHeight
                : scannerImage.naturalWidth;
            const imageHeight = rotated
                ? scannerImage.naturalWidth
                : scannerImage.naturalHeight;

            const scale = Math.min(
                availableWidth / imageWidth,
                availableHeight / imageHeight,
                1
            );

            const displayWidth = Math.max(1, Math.round(imageWidth * scale));
            const displayHeight = Math.max(1, Math.round(imageHeight * scale));
            const sourceDisplayWidth = Math.max(1, Math.round(scannerImage.naturalWidth * scale));
            const sourceDisplayHeight = Math.max(1, Math.round(scannerImage.naturalHeight * scale));

            // Size the actual image using its unrotated dimensions, then rotate it.
            // This keeps the crop corners locked to the visible invoice edges.
            scannerImage.style.width = sourceDisplayWidth + "px";
            scannerImage.style.height = sourceDisplayHeight + "px";

            scannerPreview.classList.add("has-image");
            scannerPreview.style.width = displayWidth + "px";
            scannerPreview.style.height = displayHeight + "px";
            scannerPreview.style.setProperty(
                "--scanner-image-ratio",
                imageWidth + " / " + imageHeight
            );
        };

        const clearScannerImageSizing = () => {
            scannerPreview?.classList.remove("has-image");
            scannerPreview?.style.removeProperty("width");
            scannerPreview?.style.removeProperty("height");
            scannerPreview?.style.removeProperty("--scanner-image-ratio");
            scannerImage?.style.removeProperty("width");
            scannerImage?.style.removeProperty("height");
        };

        const showPreviewBlob = (blob) => {
            revokePreview();
            previewUrl = URL.createObjectURL(blob);
            scannerImage.onload = fitScannerPreviewToImage;
            scannerImage.src = previewUrl;
            scannerImage.hidden = false;
            scannerPdf.hidden = true;
            scannerImage.style.transform = "rotate(0deg)";
            scannerImage.style.filter = "none";
            requestAnimationFrame(fitScannerPreviewToImage);
        };

        const pdfJsModulePromise = () => import(
            "https://cdn.jsdelivr.net/npm/pdfjs-dist@6.3.289/build/pdf.mjs"
        );

        const getPdfDocument = async (file) => {
            const pdfjsLib = await pdfJsModulePromise();
            pdfjsLib.GlobalWorkerOptions.workerSrc =
                "https://cdn.jsdelivr.net/npm/pdfjs-dist@6.3.289/build/pdf.worker.mjs";

            const data = new Uint8Array(await file.arrayBuffer());
            return pdfjsLib.getDocument({ data }).promise;
        };

        const renderPdfPage = async (file, pageNumber, targetCanvas = null) => {
            const pdf = await getPdfDocument(file);

            try {
                const page = await pdf.getPage(pageNumber);
                const unscaled = page.getViewport({ scale: 1 });
                const scale = Math.min(2.2, 2200 / Math.max(unscaled.width, unscaled.height));
                const viewport = page.getViewport({ scale });

                const canvas = targetCanvas || document.createElement("canvas");
                const ratio = window.devicePixelRatio || 1;
                canvas.width = Math.max(1, Math.floor(viewport.width * ratio));
                canvas.height = Math.max(1, Math.floor(viewport.height * ratio));

                const context = canvas.getContext("2d", { alpha: false });
                if (!context) throw new Error("Canvas is not supported by this browser.");

                await page.render({
                    canvasContext: context,
                    viewport,
                    transform: ratio !== 1 ? [ratio, 0, 0, ratio, 0, 0] : null
                }).promise;

                return canvas;
            } finally {
                await pdf.destroy();
            }
        };

        const processImage = async (file) => {
            const image = new Image();
            const url = URL.createObjectURL(file);

            try {
                image.src = url;
                await new Promise((resolve, reject) => {
                    image.onload = resolve;
                    image.onerror = () => reject(new Error("The invoice image could not be opened."));
                });

                const angle = ((rotation % 360) + 360) % 360;
                const swapDimensions = angle === 90 || angle === 270;
                // Keep enough resolution for small pharmacy-table text.
                const maxDimension = 3600;
                const sourceMax = Math.max(image.naturalWidth, image.naturalHeight);
                const scale = Math.min(1, maxDimension / sourceMax);

                const width = Math.max(1, Math.round(image.naturalWidth * scale));
                const height = Math.max(1, Math.round(image.naturalHeight * scale));

                const canvas = document.createElement("canvas");
                canvas.width = swapDimensions ? height : width;
                canvas.height = swapDimensions ? width : height;

                const context = canvas.getContext("2d", { alpha: false });
                if (!context) throw new Error("Canvas is not supported by this browser.");

                context.save();
                context.translate(canvas.width / 2, canvas.height / 2);
                context.rotate(angle * Math.PI / 180);
                context.filter = enhanceText
                    ? "grayscale(1) contrast(1.35) brightness(1.04)"
                    : "grayscale(1) contrast(1.12) brightness(1.02)";
                context.drawImage(image, -width / 2, -height / 2, width, height);
                context.restore();

                const blob = await new Promise(resolve =>
                    canvas.toBlob(resolve, "image/jpeg", 0.92)
                );

                if (!blob) throw new Error("Could not create the processed invoice image.");

                const baseName = (file.name || "invoice").replace(/\.[^.]+$/, "");
                return new File([blob], baseName + "-scan.jpg", {
                    type: "image/jpeg",
                    lastModified: Date.now()
                });
            } finally {
                URL.revokeObjectURL(url);
            }
        };

        const canvasToBlob = canvas => new Promise((resolve, reject) => {
            canvas.toBlob(blob => {
                if (blob) resolve(blob);
                else reject(new Error("Could not prepare the PDF preview."));
            }, "image/jpeg", 0.92);
        });

        const postVisionForParsing = async (file) => {
            const token = document.querySelector(
                '#invoiceCaptureAntiForgeryToken input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                throw new Error("Security token is missing. Refresh the dashboard and try again.");
            }

            updateOcrStatus(
                "Analyzing invoice...",
                "AI is reading the pharmacy table and extracting Product, Batch, Expiry and Qty.",
                35
            );

            const formData = new FormData();
            formData.append("invoice", file, file.name || "invoice");
            formData.append("originalFileName", file.name || "invoice");
            formData.append(
                "sourceType",
                pendingSourceType === "camera" ? "camera" : "upload"
            );

            const response = await fetch("/InvoiceCapture/ParseWithVision", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                },
                body: formData
            });

            let payload = null;
            try {
                payload = await response.json();
            } catch {
                // Keep the generic error below.
            }

            if (!response.ok || !payload?.redirectUrl) {
                throw new Error(
                    payload?.message ||
                    "The invoice could not be analyzed. Please try again with the full invoice visible."
                );
            }

            updateOcrStatus(
                "Invoice analyzed",
                "Opening the review screen so you can verify every extracted stock row.",
                100
            );

            window.location.assign(payload.redirectUrl);
        };

        const useScan = async () => {
            if (!pendingFile) return;

            if (window.pharmaFlowConnectivity && !window.pharmaFlowConnectivity.isOnline()) {
                window.pharmaFlowConnectivity.requireOnline();
                return;
            }

            resetOcrUi();
            setBusy(true);

            try {
                let finalFile = pendingFile;

                if (pendingFile.type.startsWith("image/")) {
                    finalFile = await processImage(pendingFile);
                    window.pharmaFlowInvoiceCapture = finalFile;
                    showFinalSelection(finalFile);
                } else {
                    window.pharmaFlowInvoiceCapture = pendingFile;
                }

                await postVisionForParsing(finalFile);
            } catch (error) {
                console.error("Invoice AI processing failed.", error);
                updateOcrStatus(
                    "Invoice analysis failed",
                    error?.message || "The invoice could not be analyzed.",
                    0
                );
            } finally {
                setBusy(false);
            }
        };

        const previewPdfFirstPage = async (file) => {
            try {
                const canvas = await renderPdfPage(file, 1);
                const blob = await canvasToBlob(canvas);
                showPreviewBlob(blob);
            } catch (error) {
                console.error("PDF preview failed.", error);
                scannerImage.hidden = true;
                scannerPdf.hidden = false;
                scannerPdfName.textContent = file.name;
            }
        };

        const openScanner = (file, sourceType) => {
            pendingFile = file;
            pendingSourceType = sourceType;
            rotation = 0;
            enhanceText = false;
            resetOcrUi();

            if (enhanceButton) {
                enhanceButton.setAttribute("aria-pressed", "false");
                enhanceButton.classList.remove("is-active");
            }

            if (file.type.startsWith("image/")) {
                revokePreview();
                previewUrl = URL.createObjectURL(file);
                scannerImage.onload = fitScannerPreviewToImage;
                scannerImage.src = previewUrl;
                scannerImage.hidden = false;
                scannerPdf.hidden = true;
                scannerImage.style.transform = "rotate(0deg)";
                scannerImage.style.filter = "none";
                requestAnimationFrame(fitScannerPreviewToImage);

                document.querySelectorAll("[data-image-only]").forEach(button => {
                    button.removeAttribute("hidden");
                });
            } else {
                clearScannerImageSizing();
                scannerImage.onload = null;
                scannerImage.hidden = true;
                scannerPdf.hidden = false;
                scannerPdfName.textContent = file.name;

                document.querySelectorAll("[data-image-only]").forEach(button => {
                    button.setAttribute("hidden", "");
                });

                previewPdfFirstPage(file);
            }

            scanner?.removeAttribute("hidden");
            document.body.classList.add("invoice-scanner-open");
            closeButton?.focus();
        };

        const handleInput = (input, sourceType) => {
            const file = input?.files?.[0];
            if (!file) return;

            const isImage = file.type.startsWith("image/");
            const isPdf = file.type === "application/pdf" ||
                file.name.toLowerCase().endsWith(".pdf");

            if (!isImage && !isPdf) {
                input.value = "";
                alert("Please select an invoice image or PDF.");
                return;
            }

            if (file.size > MAX_FILE_SIZE) {
                input.value = "";
                alert("Please choose an invoice file smaller than 25 MB.");
                return;
            }

            openScanner(file, isPdf ? "pdf" : sourceType);
        };

        cameraInput?.addEventListener("change", () =>
            handleInput(cameraInput, "camera")
        );

        uploadInput?.addEventListener("change", () =>
            handleInput(uploadInput, "upload")
        );

        reset?.addEventListener("click", resetSelection);
        retakeButton?.addEventListener("click", resetSelection);
        closeButton?.addEventListener("click", closeScanner);
        backdrop?.addEventListener("click", closeScanner);
        useButton?.addEventListener("click", useScan);

        rotateButton?.addEventListener("click", () => {
            rotation = (rotation + 90) % 360;
            scannerImage.style.transform = `rotate(${rotation}deg)`;
            requestAnimationFrame(fitScannerPreviewToImage);
        });

        window.addEventListener("resize", () => {
            if (!scanner?.hasAttribute("hidden") && !scannerImage.hidden) {
                fitScannerPreviewToImage();
            }
        });

        enhanceButton?.addEventListener("click", () => {
            enhanceText = !enhanceText;
            enhanceButton.setAttribute("aria-pressed", String(enhanceText));
            enhanceButton.classList.toggle("is-active", enhanceText);
            scannerImage.style.filter = enhanceText
                ? "grayscale(1) contrast(1.2) brightness(1.06)"
                : "none";
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && !scanner?.hasAttribute("hidden")) {
                closeScanner();
            }
        });
    })();
</script>
}
