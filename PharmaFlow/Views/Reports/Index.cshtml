@model PharmaFlow.Models.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="reports-mobile-page">
    <header class="reports-mobile-header">
        <a asp-controller="Home" asp-action="Index" class="reports-mobile-back" aria-label="Back to dashboard">←</a>
        <h1>Reports</h1>
    </header>

    <nav class="reports-periods" aria-label="Report period">
        <button type="button" class="reports-period-chip">Today</button>
        <button type="button" class="reports-period-chip">Last 7 days</button>
        <button type="button" class="reports-period-chip is-active">30 days</button>
        <button type="button" class="reports-period-chip">All time</button>
        <button type="button" class="reports-calendar" aria-label="Choose date range">▣</button>
    </nav>

    <section class="reports-summary-card" aria-label="Sales summary">
        <div class="reports-metric">
            <span>Total Sales Amount</span>
            <strong>₹@Model.TotalSalesAmount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
        </div>
        <div class="reports-metric reports-profit">
            <span>Profit</span>
            <strong>₹@Model.Profit.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
        </div>
        <div class="reports-metric">
            <span>No. of Bills</span>
            <strong>@Model.BillCount</strong>
        </div>
        <div class="reports-metric">
            <span>Total MRP</span>
            <strong>₹@Model.TotalMrp.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
        </div>

        <div class="reports-payment-section">
            <span class="reports-payment-title">Payment Methods</span>
            <div class="reports-payment-content">
                <div class="reports-payment-chart"
                     style="--cash:@Model.CashPercentage%; --upi:@Model.UpiPercentage%;"></div>
                <div class="reports-payment-legend">
                    <span><i class="cash"></i>Cash (@Model.CashPercentage.ToString("0")%)</span>
                    <span><i class="upi"></i>UPI (@Model.UpiPercentage.ToString("0")%)</span>
                </div>
            </div>
        </div>
    </section>

    <button type="button" class="reports-export-button" onclick="window.print()">
        <span aria-hidden="true">♧</span> Export PDF
    </button>

    <section class="reports-sellers-section">
        <h2>Top Sellers</h2>
        @if (Model.TopSellers.Count == 0)
        {
            <div class="reports-empty-sellers">
                <strong>No sales data yet</strong>
                <span>Top-selling products will appear here once bills are recorded.</span>
            </div>
        }
        else
        {
            <div class="reports-sellers-card">
                @for (var index = 0; index < Model.TopSellers.Count; index++)
                {
                    var seller = Model.TopSellers[index];
                    <article class="reports-seller-row">
                        <span class="reports-seller-rank">@(index + 1)</span>
                        <div>
                            <h3>@seller.ProductName</h3>
                            <p>@seller.QuantitySold.ToString("0.##") sold · ₹@seller.Revenue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")) revenue</p>
                            <small>MRP ₹@seller.Mrp.ToString("N0") &nbsp; Cost ₹@seller.Cost.ToString("N0") &nbsp; <b>Profit ₹@seller.Profit.ToString("N0")</b></small>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@* Print/PDF layout. The browser's Save as PDF uses this A4 landscape report template. *@
<section class="reports-print-document" aria-label="Printable sales report">
    <header class="reports-print-header">
        <div class="reports-print-brand">
            <span class="reports-print-brand-mark">✚</span>
            <div>
                <strong>@(Context.Session.GetString("BusinessName") ?? "PharmaFlow")</strong>
                <span>Pharmacy Management</span>
            </div>
        </div>
        <div class="reports-print-title">
            <strong>Sales Report - @DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(5.5)).ToString("MMMM yyyy")</strong>
            <span>Generated on: @DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(5.5)).ToString("dd MMM yyyy, h:mm tt") IST</span>
        </div>
    </header>

    <div class="reports-print-summary">
        <div><b>Total Sales:</b><span>₹@Model.TotalSalesAmount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</span></div>
        <div><b>Total Profit:</b><span>₹@Model.Profit.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</span></div>
        <div><b>Total Bills:</b><span>@Model.BillCount</span></div>
        <div><b>Generated By:</b><span>@(Context.Session.GetString("BusinessName") ?? "PharmaFlow")</span></div>
    </div>

    <table class="reports-print-table">
        <thead>
            <tr>
                <th>Bill No.</th>
                <th>Date &amp; Time</th>
                <th>Product Name</th>
                <th>Qty</th>
                <th>Payment Mode</th>
                <th>Total Amount</th>
                <th>Net Profit</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.SalesRows.Count > 0)
        {
            foreach (var row in Model.SalesRows)
            {
                <tr>
                    <td>@row.BillNumber</td>
                    <td>@row.DateTime.ToOffset(TimeSpan.FromHours(5.5)).ToString("dd MMM, h:mm tt")</td>
                    <td>@row.ProductName</td>
                    <td>@row.Quantity.ToString("0.##")</td>
                    <td>@row.PaymentMode</td>
                    <td>₹@row.TotalAmount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                    <td>₹@row.NetProfit.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                </tr>
            }
        }
        else
        {
            <tr class="reports-print-empty-row">
                <td colspan="7">Sales transaction details will appear here once billing data is connected.</td>
            </tr>
        }
        </tbody>
    </table>

    <footer class="reports-print-footer">
        <span>@(Context.Session.GetString("BusinessName") ?? "PharmaFlow") | Authorized Report</span>
        <span>Page 1 of 1</span>
    </footer>
</section>

<script>
    document.querySelector('.reports-export-button')?.addEventListener('click', function () {
        window.print();
    });
</script>
