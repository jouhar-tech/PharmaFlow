@model PharmaFlow.Models.ViewModels.InventoryProductSearchViewModel
@{
    ViewData["Title"] = "Search Products";
}

<div class="inventory-action-page">
    <header class="inventory-action-header">
        <a asp-controller="Inventory" asp-action="Index" class="inventory-action-back" aria-label="Back">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6"></path></svg>
        </a>
        <div>
            <span class="inventory-action-eyebrow">Add Item</span>
            <h1>Search Product from All Products</h1>
            <p>Search external product catalogs for medicines, cosmetics and other retail products that are not already in your inventory.</p>
        </div>
    </header>

    <form method="get" asp-action="SearchProducts" class="inventory-product-search-form" role="search">
        <span class="inventory-product-search-icon" aria-hidden="true">
            <svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10.8" cy="10.8" r="6.3"></circle>
                <path d="m16 16 4.5 4.5"></path>
            </svg>
        </span>
        <input id="allProductsSearch"
               name="query"
               value="@Model.Query"
               type="search"
               minlength="2"
               maxlength="100"
               autocomplete="off"
               placeholder="Search medicine, brand, cosmetic, product or barcode..."
               aria-label="Search all products"
               required />
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <a asp-action="SearchProducts" class="inventory-product-search-clear" aria-label="Clear search">×</a>
        }
        <button type="submit" class="inventory-product-search-button">Search</button>
    </form>

    <div class="inventory-product-search-source-note">
        <strong>Global product search</strong>
        <span>Indian medicines use the PharmaFlow medicine cache. Other medicines and general products are fetched live from external APIs. Always verify MRP, batch and expiry against the physical stock.</span>
    </div>

    <section class="inventory-product-search-results" aria-live="polite">
        @if (string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="inventory-action-empty">
                <div>
                    <svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.3"></circle>
                        <path d="m16 16 4.5 4.5"></path>
                    </svg>
                </div>
                <h2>Search the global catalog</h2>
                <p>Enter at least 2 characters to find medicines, cosmetics and other products.</p>
            </div>
        }
        else if (Model.Products.Count == 0)
        {
            <div class="inventory-action-empty">
                <div>
                    <svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.3"></circle>
                        <path d="m16 16 4.5 4.5"></path>
                        <path d="m9 9 3.5 3.5M12.5 9 9 12.5"></path>
                    </svg>
                </div>
                <h2>No products found</h2>
                <p>Try the brand name, generic name, a shorter product name or the barcode.</p>
            </div>
        }
        else
        {
            <div class="inventory-product-search-list">
                @foreach (var product in Model.Products)
                {
                    var sourceLabel = product.Source switch
                    {
                        "india-medicine-api" => "Indian Medicine Catalog",
                        "openfda-ndc" => "Drug Catalog",
                        "openfoodfacts" => "Open Product Catalog",
                        _ => product.Source
                    };

                    var typeLabel = product.ProductType switch
                    {
                        "medicine" => "Medicine",
                        "cosmetic" => "Cosmetic",
                        "pet-product" => "Other Product",
                        _ => "Product"
                    };

                    <article class="inventory-product-search-card">
                        <div class="inventory-product-search-card-main">
                            <div class="inventory-product-search-icon-badge" aria-hidden="true">
                                <svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    @if (product.ProductType == "medicine")
                                    {
                                        <path d="M7 21a5 5 0 0 1 0-10h3a5 5 0 0 1 0 10H7Z"></path>
                                        <path d="m8 11 7-7a4.95 4.95 0 1 1 7 7l-7 7"></path>
                                    }
                                    else
                                    {
                                        <rect x="5" y="3.5" width="14" height="17" rx="2"></rect>
                                        <path d="M8 8h8M8 12h8M8 16h5"></path>
                                    }
                                </svg>
                            </div>

                            <div class="inventory-product-search-card-copy">
                                <div class="inventory-product-search-tags">
                                    <span>@typeLabel</span>
                                    <span>@sourceLabel</span>
                                </div>

                                <h2>@product.ProductName</h2>

                                @if (!string.IsNullOrWhiteSpace(product.GenericName))
                                {
                                    <p>@product.GenericName</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.BrandName))
                                {
                                    <small>Brand: @product.BrandName</small>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.Manufacturer))
                                {
                                    <small>Manufacturer: @product.Manufacturer</small>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.DosageForm) ||
                                    !string.IsNullOrWhiteSpace(product.Strength) ||
                                    !string.IsNullOrWhiteSpace(product.PackSize))
                                {
                                    <small>
                                        @string.Join(" · ", new[]
                                        {
                                            product.DosageForm,
                                            product.Strength,
                                            product.PackSize
                                        }.Where(value => !string.IsNullOrWhiteSpace(value)))
                                    </small>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.Barcode))
                                {
                                    <small>Barcode: @product.Barcode</small>
                                }
                            </div>
                        </div>

                        <div class="inventory-product-search-side">
                            <a asp-action="AddItem"
                               asp-route-catalogId="@product.CatalogId"
                               asp-route-source="@(product.CatalogId.HasValue ? "india-medicine-api" : product.Source)"
                               asp-route-externalId="@product.ExternalId"
                               class="inventory-product-add-link">
                                Add to Inventory
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
