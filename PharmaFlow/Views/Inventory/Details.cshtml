@model PharmaFlow.Models.ViewModels.InventoryProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
    var batch = Model.SelectedBatch;
}

<div class="inventory-details-page">
    <header class="inventory-details-header">
        <a asp-controller="Inventory" asp-action="Index" class="inventory-details-back" aria-label="Back to Inventory">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m11 18-6-6 6-6"></path>
            </svg>
        </a>

        <div class="inventory-details-header-copy">
            <span>Inventory</span>
            <h1>Product Details</h1>
        </div>

        <button type="button"
                class="inventory-details-delete-top"
                id="inventoryRemoveProductButton">
            Remove
        </button>
    </header>

    @if (TempData["InventoryDetailsSuccess"] is string successMessage)
    {
        <div class="inventory-details-alert success" role="status">@successMessage</div>
    }

    @if (TempData["InventoryDetailsError"] is string errorMessage)
    {
        <div class="inventory-details-alert error" role="alert">@errorMessage</div>
    }

    <main class="inventory-details-content inventory-details-content-simple">
        <section class="inventory-details-card inventory-details-main-card">
            <div class="inventory-details-section-heading">
                <div>
                    <span class="section-kicker">Inventory</span>
                    <h2>Product Details</h2>
                </div>
            </div>

            @if (batch is null)
            {
                <div class="inventory-details-empty">
                    No active stock batch is available for this product.
                </div>
            }
            else
            {
                <form asp-controller="Inventory"
                      asp-action="UpdateDetails"
                      method="post"
                      class="inventory-details-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="batchId" value="@batch.BatchId" />

                    <div class="inventory-details-form-grid inventory-details-simple-grid">
                        <label>
                            <span>Product Name</span>
                            <input type="text"
                                   name="productName"
                                   value="@Model.ProductName"
                                   maxlength="200"
                                   required />
                        </label>

                        <label>
                            <span>Batch Number</span>
                            <input type="text"
                                   name="batchNumber"
                                   value="@batch.BatchNumber"
                                   maxlength="100"
                                   required />
                        </label>

                        <label>
                            <span>Quantity</span>
                            <input type="number"
                                   name="quantityOnHand"
                                   value="@batch.QuantityOnHand.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   min="0"
                                   max="999999999"
                                   step="0.01"
                                   inputmode="decimal"
                                   required />
                        </label>

                        <label>
                            <span>Purchase Price</span>
                            <input type="number"
                                   name="purchaseUnitPrice"
                                   value="@batch.PurchaseUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   min="0"
                                   max="999999999"
                                   step="0.01"
                                   inputmode="decimal"
                                   required />
                        </label>

                        <label>
                            <span>MRP</span>
                            <input type="number"
                                   name="sellingUnitPrice"
                                   value="@batch.SellingUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   min="0"
                                   max="999999999"
                                   step="0.01"
                                   inputmode="decimal"
                                   required />
                        </label>

                        <label>
                            <span>Expiry Date</span>
                            <input type="date"
                                   name="expiryDate"
                                   value="@batch.ExpiryDate.ToString("yyyy-MM-dd")"
                                   required />
                        </label>

                        <label>
                            <span>Manufacturer</span>
                            <input type="text"
                                   name="manufacturer"
                                   value="@Model.Manufacturer"
                                   maxlength="200" />
                        </label>

                        <label>
                            <span>GST Rate</span>
                            <input type="number"
                                   name="gstRate"
                                   value="@(Model.GstRate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   inputmode="decimal" />
                        </label>

                        <label class="inventory-details-field-full">
                            <span>Barcode</span>
                            <input type="text"
                                   name="barcode"
                                   value="@Model.Barcode"
                                   maxlength="100"
                                   inputmode="numeric" />
                        </label>
                    </div>

                    <div class="inventory-details-form-actions">
                        <button type="submit" class="inventory-details-primary-button">
                            Save Changes
                        </button>
                    </div>
                </form>
            }
        </section>
    </main>
</div>

<div class="inventory-remove-modal" id="inventoryRemoveModal" hidden>
    <div class="inventory-remove-backdrop" id="inventoryRemoveBackdrop"></div>
    <section class="inventory-remove-panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="inventoryRemoveTitle">
        <h2 id="inventoryRemoveTitle">Remove from stock?</h2>
        <p>This will remove the product and all of its batches from active stock. Existing sales history remains preserved.</p>

        <form asp-controller="Inventory" asp-action="RemoveProduct" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />

            <div class="inventory-remove-actions">
                <button type="button"
                        class="inventory-remove-cancel"
                        id="inventoryRemoveCancel">
                    Cancel
                </button>
                <button type="submit" class="inventory-remove-confirm">
                    Remove Product
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
<script>
(function () {
    const openButton = document.getElementById("inventoryRemoveProductButton");
    const modal = document.getElementById("inventoryRemoveModal");
    const backdrop = document.getElementById("inventoryRemoveBackdrop");
    const cancel = document.getElementById("inventoryRemoveCancel");

    const close = () => modal?.setAttribute("hidden", "");
    const open = () => modal?.removeAttribute("hidden");

    openButton?.addEventListener("click", open);
    backdrop?.addEventListener("click", close);
    cancel?.addEventListener("click", close);

    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && modal && !modal.hasAttribute("hidden"))
            close();
    });
})();
</script>
}
