@model PharmaFlow.Models.ViewModels.InventoryProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
    var batch = Model.SelectedBatch;
}

<div class="inventory-details-page inventory-details-page-v2">
    <header class="inventory-details-v2-header">
        @if (Model.ReturnTo == "expiry")
        {
            <a asp-controller="ExpiryProducts" asp-action="Index" class="inventory-details-v2-back" aria-label="Back to Expiring Products">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
            </a>
        }
        else if (Model.ReturnTo == "low-stock")
        {
            <a asp-controller="LowStock" asp-action="Index" class="inventory-details-v2-back" aria-label="Back to Low Stock">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
            </a>
        }
        else
        {
            <a asp-controller="Inventory" asp-action="Index" class="inventory-details-v2-back" aria-label="Back to Inventory">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
            </a>
        }

        <div class="inventory-details-v2-title">
            <span>Inventory</span>
            <h1>Product Details</h1>
        </div>

        <button type="button"
                class="inventory-details-v2-remove"
                id="inventoryRemoveProductButton"
                aria-label="Remove from stock"
                title="Remove from stock">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path>
            </svg>
        </button>
    </header>

    @if (TempData["InventoryDetailsSuccess"] is string successMessage)
    {
        <div class="inventory-details-alert success" role="status">@successMessage</div>
    }

    @if (TempData["InventoryDetailsError"] is string errorMessage)
    {
        <div class="inventory-details-alert error" role="alert">@errorMessage</div>
    }

    <main class="inventory-details-v2-content">
        @if (batch is null)
        {
            <section class="inventory-details-v2-card">
                <div class="inventory-details-empty">
                    No active stock batch is available for this product.
                </div>
            </section>
        }
        else
        {
            <form asp-controller="Inventory"
                  asp-action="UpdateDetails"
                  method="post"
                  class="inventory-details-v2-form"
                  id="inventoryProductDetailsForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="batchId" value="@batch.BatchId" />
                <input type="hidden" name="returnTo" value="@Model.ReturnTo" />
                @* Preserve the saved manufacturer and barcode. These remain read-only on this screen. *@
                <input type="hidden" name="manufacturer" value="@Model.Manufacturer" />
                <input type="hidden" name="barcode" value="@Model.Barcode" />
                <input type="hidden"
                       name="gstRate"
                       id="inventoryDetailsGstRateValue"
                       value="@(Model.GstRate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />

                <section class="inventory-details-v2-card" aria-labelledby="inventoryGeneralInfoHeading">
                    <h2 id="inventoryGeneralInfoHeading">General Info</h2>

                    <label class="inventory-details-v2-field">
                        <span>Product Name</span>
                        <input type="text"
                               name="productName"
                               value="@Model.ProductName"
                               maxlength="200"
                               autocomplete="off"
                               required />
                    </label>

                    <label class="inventory-details-v2-field">
                        <span>Manufacturer</span>
                        <input type="text"
                               value="@Model.Manufacturer"
                               placeholder="Manufacturer not recorded"
                               readonly
                               aria-readonly="true" />
                    </label>
                </section>

                <section class="inventory-details-v2-card" aria-labelledby="inventoryStockBatchHeading">
                    <h2 id="inventoryStockBatchHeading">Stock &amp; Batch</h2>
                    <div class="inventory-details-v2-grid">
                        <label class="inventory-details-v2-field">
                            <span>Batch Number</span>
                            <input type="text"
                                   name="batchNumber"
                                   value="@batch.BatchNumber"
                                   maxlength="100"
                                   autocomplete="off"
                                   required />
                        </label>

                        <label class="inventory-details-v2-field">
                            <span>Expiry Date</span>
                            <input type="date"
                                   name="expiryDate"
                                   value="@batch.ExpiryDate.ToString("yyyy-MM-dd")"
                                   required />
                        </label>
                    </div>
                </section>

                <section class="inventory-details-v2-card" aria-labelledby="inventoryPricingHeading">
                    <h2 id="inventoryPricingHeading">Pricing &amp; Quantity</h2>

                    <label class="inventory-details-v2-field">
                        <span>Quantity</span>
                        <input type="number"
                               name="quantityOnHand"
                               value="@batch.QuantityOnHand.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               min="0"
                               max="999999999"
                               step="0.01"
                               inputmode="decimal"
                               required />
                    </label>

                    <div class="inventory-details-v2-grid">
                        <label class="inventory-details-v2-field inventory-details-v2-money-field">
                            <span>Purchase Price</span>
                            <span class="inventory-details-v2-input-wrap">
                                <span aria-hidden="true">₹</span>
                                <input type="number"
                                       name="purchaseUnitPrice"
                                       value="@batch.PurchaseUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       min="0"
                                       max="999999999"
                                       step="0.01"
                                       inputmode="decimal"
                                       required />
                            </span>
                        </label>

                        <label class="inventory-details-v2-field inventory-details-v2-money-field">
                            <span>MRP</span>
                            <span class="inventory-details-v2-input-wrap">
                                <span aria-hidden="true">₹</span>
                                <input type="number"
                                       name="sellingUnitPrice"
                                       value="@batch.SellingUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       min="0"
                                       max="999999999"
                                       step="0.01"
                                       inputmode="decimal"
                                       required />
                            </span>
                        </label>
                    </div>
                </section>

                <section class="inventory-details-v2-card inventory-details-v2-tax-card" aria-labelledby="inventoryTaxHeading">
                    <h2 id="inventoryTaxHeading">Tax &amp; Rates</h2>
                    @{
                        var commonGstRates = new[] { 0m, 5m, 12m, 18m, 28m };
                        var currentGstIsCommon = Model.GstRate.HasValue && commonGstRates.Contains(Model.GstRate.Value);
                    }
                    <label class="inventory-details-v2-field">
                        <span>GST Rate</span>
                        <span class="inventory-details-v2-select-wrap">
                            <select id="inventoryDetailsGstRateSelect" aria-label="GST Rate">
                                <option value="">Select GST rate</option>
                                @foreach (var gst in commonGstRates)
                                {
                                    <option value="@gst.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            selected="@(Model.GstRate == gst ? "selected" : null)">
                                        @gst.ToString("0.##")%
                                    </option>
                                }
                                @if (Model.GstRate.HasValue && !currentGstIsCommon)
                                {
                                    <option value="custom" selected>Custom (@Model.GstRate.Value.ToString("0.##")%)</option>
                                }
                                else
                                {
                                    <option value="custom">Custom rate</option>
                                }
                            </select>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                        </span>
                    </label>

                    <label class="inventory-details-v2-field inventory-details-v2-custom-gst"
                           id="inventoryDetailsCustomGstWrap"
                           hidden>
                        <span>Custom GST Rate (%)</span>
                        <input type="number"
                               id="inventoryDetailsCustomGst"
                               value="@(!currentGstIsCommon && Model.GstRate.HasValue ? Model.GstRate.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                               min="0"
                               max="100"
                               step="0.01"
                               inputmode="decimal"
                               disabled />
                    </label>

                    <div class="inventory-details-v2-actions">
                        <button type="submit" class="inventory-details-v2-save">
                            Save Changes
                        </button>
                    </div>
                </section>
            </form>
        }
    </main>
</div>

<div class="inventory-remove-modal" id="inventoryRemoveModal" hidden>
    <div class="inventory-remove-backdrop" id="inventoryRemoveBackdrop"></div>
    <section class="inventory-remove-panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="inventoryRemoveTitle">
        <h2 id="inventoryRemoveTitle">Remove from stock?</h2>
        @if (Model.IsBatchContext && batch is not null)
        {
            <p>This will remove only batch <strong>@batch.BatchNumber</strong> from active stock. Existing sales history remains preserved.</p>
        }
        else
        {
            <p>This will remove the product and all of its batches from active stock. Existing sales history remains preserved.</p>
        }

        <form asp-controller="Inventory" asp-action="RemoveProduct" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="hidden" name="returnTo" value="@Model.ReturnTo" />
            @if (Model.IsBatchContext && batch is not null)
            {
                <input type="hidden" name="batchId" value="@batch.BatchId" />
            }

            <div class="inventory-remove-actions">
                <button type="button"
                        class="inventory-remove-cancel"
                        id="inventoryRemoveCancel">
                    Cancel
                </button>
                <button type="submit" class="inventory-remove-confirm">
                    <span data-i18n="removeFromStock">Remove from Stock</span>
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
<script>
(function () {
    const openButton = document.getElementById("inventoryRemoveProductButton");
    const modal = document.getElementById("inventoryRemoveModal");
    const backdrop = document.getElementById("inventoryRemoveBackdrop");
    const cancel = document.getElementById("inventoryRemoveCancel");

    const gstSelect = document.getElementById("inventoryDetailsGstRateSelect");
    const gstValue = document.getElementById("inventoryDetailsGstRateValue");
    const customGstWrap = document.getElementById("inventoryDetailsCustomGstWrap");
    const customGstInput = document.getElementById("inventoryDetailsCustomGst");

    const syncGstRate = () => {
        if (!gstSelect || !gstValue || !customGstWrap || !customGstInput) return;

        const isCustom = gstSelect.value === "custom";
        customGstWrap.hidden = !isCustom;
        customGstInput.disabled = !isCustom;
        customGstInput.required = isCustom;

        if (isCustom) {
            gstValue.value = customGstInput.value.trim();
        } else {
            gstValue.value = gstSelect.value;
        }
    };

    gstSelect?.addEventListener("change", () => {
        if (gstSelect.value === "custom" && customGstInput && !customGstInput.value) {
            customGstInput.value = "";
        }
        syncGstRate();
    });

    customGstInput?.addEventListener("input", syncGstRate);
    syncGstRate();

    const close = () => modal?.setAttribute("hidden", "");
    const open = () => modal?.removeAttribute("hidden");

    openButton?.addEventListener("click", open);
    backdrop?.addEventListener("click", close);
    cancel?.addEventListener("click", close);

    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && modal && !modal.hasAttribute("hidden"))
            close();
    });
})();
</script>
}
