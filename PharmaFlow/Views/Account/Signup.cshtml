@model PharmaFlow.Models.ViewModels.SignupViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Sign Up - PharmaFlow</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/></head>
<body class="bg-light"><div class="container min-vh-100 d-flex align-items-center justify-content-center"><div class="card shadow-sm p-4" style="max-width:420px;width:100%;border-radius:18px"><h3 class="text-center">Create your account</h3><p class="text-muted text-center">Start managing your pharmacy with PharmaFlow</p><form asp-action="Signup" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-2" maxlength="100" autocomplete="name"/><span asp-validation-for="FullName" class="text-danger"></span><label class="form-label mt-2">Phone number</label><div class="input-group"><span class="input-group-text">+91</span><input asp-for="PhoneNumber" type="tel" class="form-control" maxlength="10" inputmode="numeric" autocomplete="tel" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10);"/></div><span asp-validation-for="PhoneNumber" class="text-danger"></span><button class="btn btn-primary w-100 mt-3">Send OTP</button></form><a asp-action="Login" class="text-center mt-3">Already have an account? Login</a></div></div></body></html>
