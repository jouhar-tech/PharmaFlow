@model PharmaFlow.Models.ViewModels.SignupViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign Up - PharmaFlow</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        .password-wrapper{position:relative}.password-wrapper .form-control{padding-right:50px}
        .toggle-password{position:absolute;right:12px;top:50%;transform:translateY(-50%);border:0;background:transparent;font-size:20px}
    </style>
</head>
<body class="bg-light">
<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card shadow-sm p-4" style="max-width:420px;width:100%;border-radius:18px">
        <h3 class="text-center">Create your account</h3>
        <p class="text-muted text-center">Start managing your pharmacy with PharmaFlow</p>
        <form asp-action="Signup" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control mb-1" maxlength="50" autocomplete="username" placeholder="Choose a username" />
            <span asp-validation-for="Username" class="text-danger"></span>
            <label asp-for="Email" class="form-label mt-2">Email address</label>
            <input asp-for="Email" type="email" class="form-control mb-1" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <label asp-for="Password" class="form-label mt-2">Password</label>
            <div class="password-wrapper">
                <input asp-for="Password" type="password" id="signupPassword" class="form-control mb-1" autocomplete="new-password" />
                <button type="button" class="toggle-password" onclick="togglePassword('signupPassword', this)" aria-label="Show password">👁</button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
            <label asp-for="ConfirmPassword" class="form-label mt-2">Confirm password</label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control mb-1" autocomplete="new-password" />
                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)" aria-label="Show password">👁</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <label asp-for="PhoneNumber" class="form-label mt-2">Phone number</label>
            <div class="input-group"><span class="input-group-text">+91</span><input asp-for="PhoneNumber" type="tel" class="form-control" maxlength="10" inputmode="numeric" autocomplete="tel" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10);" /></div>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            <button class="btn btn-primary w-100 mt-3">Create Account</button>
        </form>
        <a asp-action="Login" class="text-center mt-3">Already have an account? Login</a>
    </div>
</div>
<script>
    function togglePassword(id, button) {
        const input = document.getElementById(id);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        button.textContent = isHidden ? '🙈' : '👁';
        button.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    }
</script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
