@model PharmaFlow.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - PharmaFlow</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
            body {
                background: #f8f9fc;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
            }

            .login-container {
                width: 100%;
                max-width: 430px;
                padding: 25px;
            }

            .logo {
                font-size: 32px;
                font-weight: bold;
                color: #2563eb;
            }

            .login-card {
                background: white;
                border-radius: 20px;
                padding: 30px;
                box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            }

            .phone-input {
                height: 55px;
                border-radius: 12px;
            }

            .btn-primary {
                height: 55px;
                border-radius: 12px;
                font-weight: bold;
            }

            .google-btn {
                height: 55px;
                border: 1px solid #ddd;
                border-radius: 12px;
                background: white;
            }

            .signup-link {
                text-decoration: none;
                font-weight: bold;
            }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="text-center mb-4">
            <div class="logo">PharmaFlow</div>
            <p class="text-muted mt-2">
                Your pharmacy, simplified.
            </p>
        </div>

        <div class="login-card">

            <h3 class="text-center fw-bold mb-2">
                Welcome Back
            </h3>

            <p class="text-center text-muted mb-4">
                Login using your phone number
            </p>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <label class="form-label fw-semibold">
                    Phone Number
                </label>

                <div class="input-group mb-3">
                    <span class="input-group-text">🇮🇳 +91</span>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           class="form-control phone-input"
                           placeholder="Enter 10-digit mobile number"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="tel"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                </div>

                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>

                <button type="submit"
                        class="btn btn-primary w-100 mt-3">
                    Continue
                </button>

            </form>

            <div class="text-center my-4 text-muted">
                OR
            </div>

            <button type="button"
                    class="btn google-btn w-100">
                🔵 Continue with Google
            </button>

            <p class="text-center mt-4 mb-0">
                New to PharmaFlow?
                <a href="#" class="signup-link">
                    Sign Up
                </a>
            </p>

        </div>

        <p class="text-center text-muted small mt-4">
            By continuing, you agree to our Terms and Privacy Policy.
        </p>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>