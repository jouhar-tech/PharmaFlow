@model PharmaFlow.Models.ViewModels.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - PharmaFlow</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body{background:#f8f9fc;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif}
        .login-container{width:100%;max-width:430px;padding:25px}.logo{font-size:32px;font-weight:bold;color:#2563eb}
        .login-card{background:#fff;border-radius:20px;padding:30px;box-shadow:0 5px 25px rgba(0,0,0,.08)}
        .form-control,.btn{height:55px;border-radius:12px}.password-wrapper{position:relative}.password-wrapper .form-control{padding-right:50px}
        .toggle-password{position:absolute;right:12px;top:50%;transform:translateY(-50%);border:0;background:transparent;font-size:20px}
    </style>
</head>
<body>
<div class="login-container">
    <div class="text-center mb-4"><div class="logo">PharmaFlow</div><p class="text-muted mt-2">Your pharmacy, simplified.</p></div>
    <div class="login-card">
        <h3 class="text-center fw-bold mb-2">Welcome Back</h3><p class="text-center text-muted mb-4">Login with your username</p>
        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <label asp-for="Username" class="form-label fw-semibold"></label>
            <input asp-for="Username" class="form-control mb-1" placeholder="Enter your username" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
            <label asp-for="Password" class="form-label fw-semibold mt-3"></label>
            <div class="password-wrapper">
                <input asp-for="Password" type="password" id="loginPassword" class="form-control mb-1" placeholder="Enter your password" autocomplete="current-password" />
                <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)" aria-label="Show password">👁</button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
            <button type="submit" class="btn btn-primary w-100 mt-3">Login</button>
        </form>
        <div class="text-center my-4 text-muted">OR</div>
        <a asp-action="GoogleLogin" class="btn btn-light border w-100">🔵 Continue with Google</a>
        <p class="text-center mt-4 mb-0">New to PharmaFlow? <a asp-action="Signup" class="fw-bold text-decoration-none">Sign Up</a></p>
    </div>
    <p class="text-center text-muted small mt-4">By continuing, you agree to our Terms and Privacy Policy.</p>
</div>
<script>
    function togglePassword(id, button) {
        const input = document.getElementById(id);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        button.textContent = isHidden ? '🙈' : '👁';
        button.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    }
</script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
