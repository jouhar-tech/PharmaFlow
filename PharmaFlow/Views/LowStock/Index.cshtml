@model PharmaFlow.Models.ViewModels.LowStockViewModel

@{
    ViewData["Title"] = "Low Stock";
}

<div class="low-stock-page-modern">
    <header class="low-stock-modern-header">
        <a asp-controller="Home" asp-action="Index" class="low-stock-modern-back" aria-label="Back to dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg></a>
        <h1 data-i18n="lowStock">Low Stock</h1>
    </header>

    <section class="low-stock-modern-summary">
        <div class="low-stock-summary-icon">!</div>
        <div>
            <span data-i18n="lowStockProducts">Low Stock Products</span>
            <strong>@Model.Count</strong>
            <small>Products with quantity below 3</small>
        </div>
    </section>

    <form class="low-stock-modern-search" role="search" onsubmit="return false;">
        <span class="low-stock-modern-search-icon" aria-hidden="true"><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg></span>
        <input id="lowStockSearch"
               type="search"
               value="@Model.SearchTerm"
               data-i18n-placeholder="searchProductBatch" placeholder="Search product or batch..."
               autocomplete="off"
               aria-label="Search low stock products or batch numbers" />
        <button id="lowStockSearchClear" type="button" aria-label="Clear search" hidden>×</button>
    </form>

    <a asp-controller="Reorder"
       asp-action="Index"
       id="lowStockReorderListCard"
       class="low-stock-reorder-list-card @(Model.ReorderListCount > 0 ? "" : "is-hidden")"
       aria-hidden="@(Model.ReorderListCount > 0 ? "false" : "true")">
        <span class="low-stock-reorder-list-count" id="lowStockReorderCount">@Model.ReorderListCount</span>
        <span class="low-stock-reorder-list-copy">
            <strong>Reorder List</strong>
            <small>Items queued to order from a distributor</small>
        </span>
        <span class="low-stock-reorder-list-chevron" aria-hidden="true">›</span>
    </a>
    <p id="lowStockReorderFeedback" class="low-stock-reorder-feedback" role="status" aria-live="polite" hidden></p>

    <section class="low-stock-modern-products" aria-label="Low stock products">
        @if (Model.Items.Count == 0)
        {
            <div class="low-stock-modern-empty">
                <div><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7"/><path d="M12 12v6M9 15h6"/></svg></div>
                <h2>No low stock products</h2>
                <p>Products with quantity below 3 will appear here.</p>
            </div>
        }
        else
        {
            <div class="low-stock-products-grid">
                @foreach (var item in Model.Items)
                {
                    <article class="low-stock-product-card"
                             data-search-text="@($"{item.ProductName} {item.GenericName} {item.BrandName} {item.BatchNumber} {item.Barcode}")">
                        <div class="low-stock-product-card-top">
                            <div class="low-stock-product-icon">Rx</div>
                            <div class="low-stock-product-heading">
                                <h2>@item.ProductName</h2>
                                <span>Batch : @item.BatchNumber</span>
                            </div>
                            <a asp-controller="Inventory"
                               asp-action="Details"
                               asp-route-productId="@item.ProductId"
                               asp-route-batchId="@item.BatchId"
                               asp-route-returnTo="low-stock"
                               class="low-stock-product-edit"
                               data-i18n="edit"
                               aria-label="Edit product"
                               title="Edit product">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
                                <span>Edit</span>
                            </a>
                        </div>

                        <div class="low-stock-product-details">
                            <div>
                                <span>QTY</span>
                                <strong class="low-stock-qty">@item.Quantity.ToString("0.##")</strong>
                            </div>
                            <div>
                                <span>EXPIRY DATE</span>
                                <strong>@item.ExpiryDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div>
                                <span>SELLING PRICE</span>
                                <strong>₹ @item.SellingUnitPrice.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>STOCK VALUE</span>
                                <strong>₹ @item.StockValue.ToString("N2")</strong>
                            </div>
                        </div>

                        <div class="low-stock-product-actions">
                            <span class="low-stock-status-badge">Low stock</span>
                            <form asp-controller="Reorder"
                                  asp-action="Add"
                                  data-product-id="@item.ProductId"
                                  data-remove-url="@Url.Action("Remove", "Reorder")"
                                  method="post"
                                  class="low-stock-reorder-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit"
                                        class="low-stock-reorder-inline @(item.IsInReorderList ? "is-added" : "")"
                                        data-added="@(item.IsInReorderList ? "true" : "false")"
                                        data-reorder-list-item-id="@(item.ReorderListItemId?.ToString() ?? string.Empty)"
                                        aria-label="@(item.IsInReorderList ? "Remove product from Reorder List" : "Add product to Reorder List")">
                                    @if (item.IsInReorderList)
                                    {
                                        <text>Remove</text>
                                    }
                                    else
                                    {
                                        <text>Reorder <span aria-hidden="true">→</span></text>
                                    }
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>

            <div id="lowStockEmptySearch" class="low-stock-modern-empty" hidden>
                <div><svg class="pharma-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg></div>
                <h2>No products found</h2>
                <p>Try another product name, batch number or barcode.</p>
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    const search = document.getElementById('lowStockSearch');
    const clear = document.getElementById('lowStockSearchClear');
    const cards = Array.from(document.querySelectorAll('.low-stock-product-card'));
    const empty = document.getElementById('lowStockEmptySearch');
    const reorderCard = document.getElementById('lowStockReorderListCard');
    const reorderCount = document.getElementById('lowStockReorderCount');
    const reorderFeedback = document.getElementById('lowStockReorderFeedback');
    const reorderForms = Array.from(document.querySelectorAll('.low-stock-reorder-form'));

    if (!search) return;

    function update() {
        const term = search.value.trim().toLocaleLowerCase();
        let visible = 0;

        cards.forEach(card => {
            const text = (card.dataset.searchText || '').toLocaleLowerCase();
            const show = !term || text.includes(term);
            card.hidden = !show;
            if (show) visible++;
        });

        clear.hidden = !term;
        if (empty) empty.hidden = visible !== 0;
    }

    search.addEventListener('input', update);

    clear?.addEventListener('click', function () {
        search.value = '';
        search.focus();
        update();
    });

    update();

    function setReorderButtonState(button, isAdded, reorderListItemId) {
        if (!button) return;

        if (isAdded) {
            button.textContent = 'Remove';
            button.classList.add('is-added');
            button.dataset.added = 'true';
            if (reorderListItemId) {
                button.dataset.reorderListItemId = String(reorderListItemId);
            }
            button.setAttribute('aria-label', 'Remove product from Reorder List');
        } else {
            button.innerHTML = 'Reorder <span aria-hidden="true">→</span>';
            button.classList.remove('is-added');
            delete button.dataset.added;
            delete button.dataset.reorderListItemId;
            button.setAttribute('aria-label', 'Add product to Reorder List');
        }
    }

    // A product can have multiple low-stock batches, so keep their buttons in sync.
    function setProductReorderState(productId, isAdded, reorderListItemId) {
        const key = String(productId);
        reorderForms
            .filter(candidate => candidate.dataset.productId === key)
            .forEach(candidate => {
                setReorderButtonState(
                    candidate.querySelector('button[type="submit"]'),
                    isAdded,
                    reorderListItemId);
            });
    }

    function updateReorderListCard(count) {
        if (!Number.isInteger(count) || count < 0) return;

        reorderCount.textContent = count.toLocaleString();
        if (count > 0) {
            reorderCard.classList.remove('is-hidden');
            reorderCard.setAttribute('aria-hidden', 'false');
        } else {
            reorderCard.classList.add('is-hidden');
            reorderCard.setAttribute('aria-hidden', 'true');
        }
    }

    // Toggle each row between Reorder and Remove without leaving Low Stock.
    reorderForms.forEach(form => {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const button = form.querySelector('button[type="submit"]');
            if (!button || button.disabled) return;

            const isRemoving = button.dataset.added === 'true';
            const payload = new FormData(form);
            let requestUrl = form.action;

            if (isRemoving) {
                const reorderListItemId = button.dataset.reorderListItemId;
                if (!reorderListItemId) {
                    reorderFeedback.textContent = 'Could not identify this Reorder List item. Refresh the page and try again.';
                    reorderFeedback.classList.remove('is-success');
                    reorderFeedback.classList.add('is-error');
                    reorderFeedback.hidden = false;
                    return;
                }

                requestUrl = form.dataset.removeUrl;
                payload.delete('productId');
                payload.set('reorderListItemId', reorderListItemId);
            }

            button.disabled = true;
            button.setAttribute('aria-busy', 'true');

            try {
                const response = await fetch(requestUrl, {
                    method: 'POST',
                    body: payload,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    credentials: 'same-origin'
                });

                const result = await response.json().catch(() => null);
                if (!response.ok || !result) {
                    throw new Error(result?.message || 'Could not update the Reorder List. Please try again.');
                }

                updateReorderListCard(result.count);

                if (!isRemoving && (result.success || result.alreadyAdded) && result.reorderListItemId) {
                    setProductReorderState(form.dataset.productId, true, result.reorderListItemId);
                } else if (isRemoving && result.success) {
                    setProductReorderState(form.dataset.productId, false);
                }

                if (isRemoving && result.success) {
                    reorderFeedback.textContent = result.count === 0
                        ? 'Item removed. Your Reorder List is now empty.'
                        : 'Item removed from Reorder List.';
                    reorderFeedback.classList.add('is-success');
                    reorderFeedback.classList.remove('is-error');
                } else if (result.success) {
                    reorderFeedback.textContent = result.count === 1
                        ? '1 item added to Reorder List.'
                        : result.count + ' items currently in Reorder List.';
                    reorderFeedback.classList.add('is-success');
                    reorderFeedback.classList.remove('is-error');
                } else {
                    reorderFeedback.textContent = result.message || 'This product could not be updated.';
                    reorderFeedback.classList.remove('is-success');
                    reorderFeedback.classList.add('is-error');
                }

                reorderFeedback.hidden = false;
            } catch (error) {
                reorderFeedback.textContent = error instanceof Error
                    ? error.message
                    : 'Could not update the Reorder List. Please try again.';
                reorderFeedback.classList.remove('is-success');
                reorderFeedback.classList.add('is-error');
                reorderFeedback.hidden = false;
            } finally {
                button.disabled = false;
                button.removeAttribute('aria-busy');
            }
        });
    });
})();
</script>
}
