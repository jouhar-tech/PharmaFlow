@model PharmaFlow.Models.ViewModels.ExpiringProductsViewModel

@{
    ViewData["Title"] = "Expiring Products";
    var filter = string.IsNullOrWhiteSpace(Model.ViewMode) ? "all" : Model.ViewMode;
}

<div class="expiry-page expiry-page-modern">
    <header class="expiry-modern-header">
        <a asp-controller="Home" asp-action="Index" class="expiry-modern-back" aria-label="Back to dashboard">←</a>
        <div>
            <span class="expiry-modern-kicker" data-i18n="expiryManagement">Expiry Management</span>
            <h1 data-i18n="productsExpiringSoonPage">Expiring Products</h1>
            
        </div>
    </header>

    <section class="expiry-modern-risk-card" aria-label="Total value at risk">
        <div class="expiry-modern-risk-icon">₹</div>
        <div>
            <span data-i18n="atRiskValue">Total Value at Risk</span>
            <strong>₹ @Model.AtRiskValue.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong>
            <small data-i18n="expiryAtRiskDescription">Cost value of stock expiring within 90 days</small>
        </div>
    </section>

    <form class="expiry-modern-search" role="search" onsubmit="return false;">
        <span class="expiry-modern-search-icon" aria-hidden="true">⌕</span>
        <input type="search"
               name="search"
               value="@Model.SearchTerm"
               data-i18n-placeholder="searchProductBatch" placeholder="Search product or batch..."
               data-i18n-placeholder="searchExpiryProducts"
               autocomplete="off"
               aria-label="Search expiring products or batch numbers" />
        <button type="button" class="expiry-modern-clear" aria-label="Clear search" hidden>×</button>
    </form>

    <nav class="expiry-modern-filters" aria-label="Expiry filters">
        <button type="button" class="expiry-filter-chip is-active" data-filter="all">
            All <span class="expiry-filter-count all">@Model.AllCount</span>
        </button>
        <button type="button" class="expiry-filter-chip" data-filter="critical">
            Expires in 30 <span class="expiry-filter-count critical">@Model.CriticalCount</span>
        </button>
        <button type="button" class="expiry-filter-chip" data-filter="upcoming">
            Expires in 60 <span class="expiry-filter-count upcoming">@Model.UpcomingCount</span>
        </button>
        <button type="button" class="expiry-filter-chip" data-filter="expired">
            Expired <span class="expiry-filter-count expired">@Model.ExpiredCount</span>
        </button>
    </nav>

    <section class="expiry-modern-summary" aria-label="Expiry summary">
        <article class="expiry-modern-summary-card critical">
            <span>!</span>
            <div><strong>@Model.CriticalCount</strong><small>Critical</small></div>
        </article>
        <article class="expiry-modern-summary-card upcoming">
            <span>⌛</span>
            <div><strong>@Model.UpcomingCount</strong><small>Upcoming</small></div>
        </article>
        <article class="expiry-modern-summary-card total">
            <span>₹</span>
            <div><strong>₹ @Model.AtRiskValue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong><small>At-Risk Value</small></div>
        </article>
    </section>

    <section class="expiry-modern-products" aria-label="Expiring products">
        @if (Model.Products.Count == 0)
        {
            <div class="expiry-modern-empty">
                <div>✓</div>
                <h2>No matching expiring products</h2>
                <p>Try a different product name or batch number.</p>
            </div>
        }
        else
        {
            <div class="expiry-products-grid expiry-modern-products-grid">
                @foreach (var product in Model.Products)
                {
                    <partial name="_ExpiryProductCard" model="product" />
                }
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    const search = document.querySelector('.expiry-modern-search input[type="search"]');
    const clear = document.querySelector('.expiry-modern-clear');
    const filterButtons = Array.from(document.querySelectorAll('.expiry-filter-chip'));
    const cards = Array.from(document.querySelectorAll('.expiry-product-card'));

    if (!search || !cards.length) return;

    let activeFilter = 'all';

    function matchesFilter(card) {
        const days = Number(card.dataset.daysLeft);
        if (activeFilter === 'critical') return days >= 0 && days <= 30;
        if (activeFilter === 'upcoming') return days > 30 && days <= 60;
        if (activeFilter === 'expired') return days < 0;
        return true;
    }

    function updateResults() {
        const term = search.value.trim().toLocaleLowerCase();
        let visible = 0;

        cards.forEach(card => {
            const haystack = (card.dataset.searchText || '').toLocaleLowerCase();
            const matchesSearch = !term || haystack.includes(term);
            const show = matchesSearch && matchesFilter(card);
            card.hidden = !show;
            if (show) visible++;
        });

        clear.hidden = !term;
        const empty = document.querySelector('.expiry-modern-empty');
        if (empty) empty.hidden = visible !== 0;
    }

    search.addEventListener('input', updateResults);

    clear?.addEventListener('click', function () {
        search.value = '';
        search.focus();
        updateResults();
    });

    filterButtons.forEach(button => {
        button.addEventListener('click', function () {
            activeFilter = button.dataset.filter || 'all';
            filterButtons.forEach(item => item.classList.toggle('is-active', item === button));
            updateResults();
        });
    });

    updateResults();
})();
</script>
}